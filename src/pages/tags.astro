---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/navigation";

const tags = await getTagList();
const sortedTags = [...tags].sort(
	(a, b) =>
		b.count - a.count ||
		a.name.localeCompare(b.name, undefined, { sensitivity: "base" }),
);
const commonTags = sortedTags.filter((tag) => tag.count > 1);
const singleTags = sortedTags.filter((tag) => tag.count === 1);
const maxCount = sortedTags[0]?.count ?? 1;
const groups = [commonTags, singleTags];
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.tags)}>
	<section
		class="tags-page card-base px-5 py-7 sm:px-8 sm:py-9"
		aria-label={i18n(I18nKey.tags)}
	>
		<div class="tags-header">
			<p>
				<strong>{tags.length}</strong> 个标签{sortedTags.length > 0 && (
					<span> · 最常用 <a href={getTagUrl(sortedTags[0].name)}>{sortedTags[0].name}</a></span>
				)}
			</p>
		</div>
		{tags.length === 0 ? (
			<p>{i18n(I18nKey.noTags)}</p>
		) : groups.map((group, index) => {
			const cloud = (
				<ul class="tags-cloud">
					{group.map((tag) => (
						<li>
							<a
								href={getTagUrl(tag.name)}
								class:list={[
									"tag-link",
									{ "popular-tag": tag.count > 1 && tag.count >= maxCount / 2 },
								]}
								style={`--tag-size: ${14 + 8 * (tag.count - 1) / Math.max(1, maxCount - 1)}px`}
							>
								{tag.name}<sup>{tag.count}</sup>
							</a>
						</li>
					))}
				</ul>
			);
			return index === 0 ? cloud : group.length > 0 && (
				<details class="single-tags" open>
					<summary>还有 {singleTags.length} 个只出现过一次的标签</summary>
					{cloud}
				</details>
			);
		})}
	</section>
</MainGridLayout>

<style>
	.tags-page {
		color: var(--content-meta);
	}
	.tags-header {
		margin-bottom: 2rem;
		font-size: 14px;
	}
	.tags-header strong,
	.tags-header a {
		font-size: 18px;
		font-weight: 600;
		color: var(--primary);
	}
	.tags-cloud {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 12px 16px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tag-link {
		font-size: var(--tag-size);
		line-height: 1.6;
		overflow-wrap: anywhere;
		transition: color 180ms ease;
	}
	.tag-link sup {
		margin-left: 3px;
		font-size: 10px;
		font-weight: 400;
		color: var(--content-meta);
	}
	.popular-tag {
		color: var(--primary);
		font-weight: 600;
	}
	.tag-link:hover {
		color: var(--primary);
	}
	.single-tags {
		margin-top: 2rem;
		font-size: 14px;
	}
	summary {
		cursor: pointer;
	}
	.single-tags .tags-cloud {
		margin-top: 1.25rem;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 4px;
	}
</style>
