---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/navigation";

const tags = await getTagList();
const sortedTags = [...tags].sort(
	(a, b) =>
		b.count - a.count ||
		a.name.localeCompare(b.name, undefined, { sensitivity: "base" }),
);
const commonTags = sortedTags.filter((tag) => tag.count > 1);
const singleTags = sortedTags.filter((tag) => tag.count === 1);
const maxCount = sortedTags[0]?.count ?? 1;
const groups = [commonTags, singleTags];
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.tags)}>
	<section
		class="tags-page card-base px-5 py-7 sm:px-8 sm:py-9"
		data-tags-page
		aria-label={i18n(I18nKey.tags)}
	>
		<div class="tags-header">
			<p>
				<strong>{tags.length}</strong> 个标签{sortedTags.length > 0 && (
					<span> · 最常用 <a href={getTagUrl(sortedTags[0].name)}>{sortedTags[0].name}</a></span>
				)}
			</p>
			<label>
				<span class="sr-only">搜索标签</span>
				<input type="search" placeholder="输入标签名称" data-tag-search />
				<button type="button" class="tag-search-clear" data-tag-search-clear aria-label="清空搜索" hidden>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="svelte-1n2o1uz"><path d="m6 6 12 12M18 6 6 18" class="svelte-1n2o1uz"></path></svg>
				</button>
			</label>
		</div>
		{tags.length === 0 ? (
			<p>{i18n(I18nKey.noTags)}</p>
		) : groups.map((group, index) => {
			const cloud = (
				<ul class="tags-cloud">
					{group.map((tag) => (
						<li data-tag-name={tag.name.toLocaleLowerCase()}>
							<a
								href={getTagUrl(tag.name)}
								class:list={[
									"tag-link",
									{ "popular-tag": tag.count > 1 && tag.count >= maxCount / 2 },
								]}
								style={`--tag-size: ${14 + 8 * (tag.count - 1) / Math.max(1, maxCount - 1)}px`}
							>
								{tag.name}<sup>{tag.count}</sup>
							</a>
						</li>
					))}
				</ul>
			);
			return index === 0 ? cloud : group.length > 0 && (
				<details class="single-tags" data-single-tags>
					<summary>还有 {singleTags.length} 个只出现过一次的标签</summary>
					{cloud}
				</details>
			);
		})}
		<p class="no-results" data-no-results hidden role="status">没有找到匹配的标签</p>
	</section>
</MainGridLayout>

<script>
	function initTagSearch() {
		document.querySelectorAll<HTMLElement>("[data-tags-page]").forEach((page) => {
			if (page.dataset.initialized) return;
			page.dataset.initialized = "true";
			const input = page.querySelector<HTMLInputElement>("[data-tag-search]")!;
			const clear = page.querySelector<HTMLButtonElement>("[data-tag-search-clear]")!;
			const items = page.querySelectorAll<HTMLElement>("[data-tag-name]");
			const singles = page.querySelector<HTMLDetailsElement>("[data-single-tags]");
			const noResults = page.querySelector<HTMLElement>("[data-no-results]")!;
			let wasOpen = false;
			let searching = false;
			clear.addEventListener("click", () => {
				input.value = "";
				input.dispatchEvent(new Event("input"));
				input.focus();
			});
			input.addEventListener("input", () => {
				clear.hidden = input.value.length === 0;
				const query = input.value.trim().toLocaleLowerCase();
				let matches = 0;
				let singleMatches = 0;
				items.forEach((item) => {
					item.hidden = !item.dataset.tagName!.includes(query);
					if (!item.hidden) {
						matches++;
						if (singles?.contains(item)) singleMatches++;
					}
				});
				if (singles) {
					if (query && !searching) wasOpen = singles.open;
					singles.open = query ? true : wasOpen;
					singles.hidden = query.length > 0 && singleMatches === 0;
				}
				searching = query.length > 0;
				noResults.hidden = matches > 0;
			});
		});
	}
	initTagSearch();
	document.addEventListener("astro:page-load", initTagSearch);
</script>

<style>
	.tags-page {
		color: var(--content-meta);
	}
	.tags-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 2rem;
		font-size: 14px;
	}
	.tags-header strong,
	.tags-header a {
		font-size: 18px;
		font-weight: 600;
		color: var(--primary);
	}
	.tags-header label {
		position: relative;
		max-width: 100%;
	}
	.tags-header input {
		width: 224px;
		max-width: 100%;
		padding: 8px 38px 8px 14px;
		border: 1px solid var(--line-divider);
		border-radius: 999px;
		background: var(--btn-regular-bg);
		color: var(--juejin-text-primary);
		font-size: 13px;
	}
	.tags-header input::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}
	.tag-search-clear {
		position: absolute;
		right: 14px;
		top: 50%;
		transform: translateY(-50%);
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
		line-height: 0;
	}
	.tags-cloud {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 12px 16px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tag-link {
		font-size: var(--tag-size);
		line-height: 1.6;
		overflow-wrap: anywhere;
		transition: color 180ms ease;
	}
	.tag-link sup {
		margin-left: 3px;
		font-size: 10px;
		font-weight: 400;
		color: var(--content-meta);
	}
	.popular-tag {
		color: var(--primary);
		font-weight: 600;
	}
	.tag-link:hover {
		color: var(--primary);
	}
	.single-tags {
		margin-top: 2rem;
		font-size: 14px;
	}
	summary {
		cursor: pointer;
	}
	.single-tags .tags-cloud {
		margin-top: 1.25rem;
	}
	.no-results {
		margin-top: 1.5rem;
		font-size: 14px;
	}
	input:focus-visible{
		outline: none;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 4px;
	}
</style>
