---
import { profileConfig, siteConfig } from "@/config";
import { essaysConfig } from "@/config/essaysConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/navigation";

if (!siteConfig.pages.essays) {
	return Astro.redirect("/404/");
}

const essays = [...essaysConfig.items].sort((a, b) =>
	b.date.localeCompare(a.date),
);
---

<MainGridLayout title={essaysConfig.title} description={essaysConfig.description}>
	<section class="essays-page card-base" aria-labelledby="essays-title">
		<header class="essays-header">
			<h1 id="essays-title">{essaysConfig.title}</h1>
			<p>{essaysConfig.description}</p>
		</header>
		{essays.length > 0 ? (
			<ol class="essays-list">
				{essays.map((essay) => (
					<li>
						<article class="essay-entry">
							<div class="essay-avatar">
								{profileConfig.avatar && (
									<img
										src={profileConfig.avatar.startsWith("/") ? url(profileConfig.avatar) : profileConfig.avatar}
										alt={profileConfig.name}
										width="40"
										height="40"
										loading="lazy"
									/>
								)}
							</div>
							<div class="essay-body">
								<header class="essay-author">
									<span class="essay-author-name">{profileConfig.name}</span>
									{profileConfig.level && <span class="essay-author-level">{profileConfig.level}</span>}
								</header>
							<p class="essay-content">{essay.content}</p>
							{essay.images && essay.images.length > 0 && (
								<div class="essay-images">
									{essay.images.map((image) => (
										<img
											src={image.startsWith("/") ? url(image) : image}
											loading="lazy"
										/>
									))}
								</div>
							)}
								<time datetime={essay.date}>{essay.date}</time>
							</div>
						</article>
					</li>
				))}
			</ol>
		) : (
			<p class="essays-empty">暂时还没有随笔。</p>
		)}
	</section>
</MainGridLayout>

<style>
	.essays-page {
		padding: clamp(24px, 5vw, 48px);
		color: var(--juejin-text-primary);
	}
	.essays-header {
		padding-bottom: 24px;
		border-bottom: 1px solid var(--line-divider);
	}
	h1 {
		font-size: 1.75rem;
		font-weight: 700;
	}
	.essays-header p,
	.essays-empty {
		margin-top: 12px;
		color: var(--juejin-text-secondary);
		line-height: 1.8;
	}
	.essays-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.essays-list li {
		padding: 28px 0;
	}
	.essays-list li + li {
		border-top: 1px solid var(--line-divider);
	}
	.essay-entry {
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr);
		gap: 14px;
	}
	.essay-avatar img {
		display: block;
		width: 40px;
		height: 40px;
		object-fit: cover;
		border-radius: 4px;
	}
	.essay-author {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		min-height: 24px;
	}
	.essay-author-name {
		color: var(--primary);
		font-weight: 700;
	}
	.essay-author-level {
		padding: 0 4px;
		border: 1px solid currentColor;
		border-radius: 3px;
		color: var(--primary);
		font-size: 0.75rem;
		line-height: 1.5;
	}
	time {
		display: block;
		margin-top: 24px;
		font-size: 0.875rem;
		color: var(--juejin-text-secondary);
	}
	.essay-content {
		margin-top: 12px;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		line-height: 1.9;
	}
	.essay-images {
		display: grid;
		gap: 12px;
		margin-top: 16px;
	}
	.essay-images img {
		cursor: zoom-in;
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		border-radius: 8px;
	}
</style>
