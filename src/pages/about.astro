---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { aboutPageConfig } from "@/config/aboutConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { getCategoryList, getSortedPosts, getTagList } from "@/utils/content-utils";
import { url } from "@/utils/navigation";
import ContentCharts from "@components/pages/about/ContentCharts.astro";

const [posts, tags, categories] = await Promise.all([
	getSortedPosts(),
	getTagList(),
	getCategoryList(),
]);
const statistics = [
	{ value: posts.length, label: "篇文章" },
	{ value: tags.length, label: "个标签" },
	{ value: categories.length, label: "个分类" },
];
---

<MainGridLayout title={i18n(I18nKey.about)} description={aboutPageConfig.introduction}>
	<article class="about-page card-base">
		<header class="about-header">
			<img src={url(profileConfig.avatar!)} alt={`${profileConfig.name}的头像`} width="96" height="96" />
			<div>
				<p class="eyebrow">ABOUT ME</p>
				<h1>你好，我是 {profileConfig.name}。</h1>
				<p class="role">{aboutPageConfig.role}</p>
			</div>
		</header>

		<div class="about-introduction">
			<p>{aboutPageConfig.introduction}</p>
			<p>很高兴，在这里与你相遇。</p>
		</div>

		<section class="about-section" aria-labelledby="research-title">
			<p class="eyebrow">研究与探索</p>
			<h2 id="research-title">{aboutPageConfig.pursuit.replace("\n", "")}</h2>
			<p class="research-keywords">{aboutPageConfig.keywords.join(" · ")}</p>
			<dl class="research-directions">
				{aboutPageConfig.directions.map((direction) => (
					<div>
						<dt>{direction.title}</dt>
						<dd>{direction.description}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="about-section" aria-labelledby="blog-title">
			<p class="eyebrow">关于这个博客</p>
			<h2 id="blog-title">让知识慢慢积累。</h2>
			<p>始于 {siteConfig.siteStartDate}，每一篇都是探索的足迹。</p>
			<dl class="statistics">
				{statistics.map((stat) => (
					<div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
				))}
			</dl>
			<a class="archive-link" href={url("/archive/")}>看看我的记录 <span aria-hidden="true">↗</span></a>
		</section>

		<div class="about-charts">
			<ContentCharts posts={posts} categories={categories} />
		</div>
	</article>
</MainGridLayout>

<style>
	.about-page {
		padding: clamp(24px, 5vw, 64px);
		color: var(--juejin-text-primary);
		line-height: 1.9;
	}
	.about-header {
		display: flex;
		align-items: center;
		gap: 24px;
	}
	.about-header img {
		flex-shrink: 0;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
	}
	.eyebrow {
		margin-bottom: 8px;
		font-size: 12px;
		letter-spacing: 0.1em;
		color: var(--primary);
	}
	h1 {
		font-size: clamp(26px, 3vw, 38px);
		font-weight: 700;
		line-height: 1.4;
	}
	h2 {
		margin-bottom: 16px;
		font-size: clamp(22px, 2.3vw, 28px);
		font-weight: 600;
		line-height: 1.5;
	}
	.role, .research-keywords, dd, .about-section > p:not(.eyebrow) {
		color: var(--content-meta);
	}
	.role { margin-top: 8px; }
	.about-introduction { margin-top: 32px; font-size: 17px; }
	.about-introduction p + p { margin-top: 8px; }
	.about-section, .about-charts {
		margin-top: 40px;
		padding-top: 32px;
		border-top: 1px solid var(--line-divider);
	}
	.research-keywords { font-size: 14px; }
	.research-directions { margin-top: 24px; }
	.research-directions div + div { margin-top: 20px; }
	.research-directions dt { font-weight: 600; }
	.research-directions dd { margin-top: 4px; }
	.statistics { display: flex; flex-wrap: wrap; gap: 24px 48px; margin: 24px 0; }
	.statistics div { display: flex; flex-direction: column-reverse; }
	.statistics dt { font-size: 13px; color: var(--content-meta); }
	.statistics dd { font-size: 32px; font-weight: 600; line-height: 1.4; color: var(--primary); font-variant-numeric: tabular-nums; }
	.archive-link { color: var(--primary); text-underline-offset: 4px; }
	.archive-link:hover { text-decoration: underline; }
	.about-charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
	@media (max-width: 767px) {
		.about-charts { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 479px) {
		.about-header { align-items: flex-start; flex-direction: column; gap: 16px; }
		.about-header img { width: 72px; height: 72px; }
	}
</style>
