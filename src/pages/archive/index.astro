---
import ArchiveList from "@/components/layout/ArchiveList.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getArchivePostsList } from "@/utils/content-utils";

const posts = await getArchivePostsList();
---
<MainGridLayout title={i18n(I18nKey.archive)} hideSidebar wideContent>
	<ArchiveList posts={posts} />
</MainGridLayout>
