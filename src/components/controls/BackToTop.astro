---
import { Icon } from "astro-icon/components";
---

<div id="back-to-top-wrapper" class="back-to-top-wrapper">
  <button
    id="back-to-top-btn"
    type="button"
    class="floating-control-button"
    aria-label="返回顶部"
    title="返回顶部"
    onclick="backToTop()"
  >
    <Icon name="ri:arrow-up-s-line" />
  </button>
</div>

<script>
  window.backToTop = function () {
    // 直接使用原生滚动，避免OverlayScrollbars冲突
    window.scroll({ top: 0, behavior: "smooth" });
  };

</script>

<style is:global>
  #back-to-top-wrapper {
    width: 2.5rem;
    height: 2.5rem;
    pointer-events: auto;
  }
</style>
