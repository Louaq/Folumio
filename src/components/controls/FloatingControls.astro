---
import { siteConfig } from "@/config/siteConfig";
import BackToTop from "./BackToTop.astro";
import FloatingMusic from "./FloatingMusic.astro";
import PostChat from "./PostChat.astro";
---

<div class="floating-controls-container">
  <slot />
  {siteConfig.aiSummary && <PostChat />}
  {siteConfig.floatingControls.music && <FloatingMusic />}
  {siteConfig.floatingControls.backToTop && <BackToTop />}
</div>

<style is:global>
  /* Visual treatment adapted from astro-koharu FloatingGroup (AGPL-3.0). */
  .floating-control-button {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--theme-color) 10%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--page-bg) 85%, transparent);
    color: var(--theme-color);
    cursor: pointer;
    pointer-events: auto;
    box-sizing: border-box;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--theme-color) 12%, transparent);
    transition: background-color .3s, border-color .3s, box-shadow .3s, translate .3s, scale .1s;
  }
  .floating-control-button svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  @media (hover: hover) {
    .floating-control-button:hover {
      translate: 0 -2px;
      background: var(--page-bg);
      border-color: color-mix(in srgb, var(--theme-color) 25%, transparent);
      box-shadow: 0 6px 18px color-mix(in srgb, var(--theme-color) 18%, transparent);
    }
  }
  .floating-control-button:active {
    scale: .9;
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-control-button,
    .floating-control-button:hover,
    .floating-control-button:active {
      transition: none;
      translate: none;
      scale: none;
    }
  }
  .floating-control-button:focus-visible {
    outline: 2px solid var(--theme-color);
    outline-offset: 2px;
  }
  .floating-controls-container {
    position: fixed;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end; /* 右对齐 */
    pointer-events: none; /* 容器不阻挡点击 */
    
    /* 默认桌面端位置 - 对应 BackToTop 的位置 */
    --floating-controls-right: 2rem;
    right: var(--floating-controls-right);
    bottom: 4rem;
  }

  /* 响应式调整 - 保持原有的位置逻辑 */
  @media (max-width: 1024px) {
    .floating-controls-container {
      --floating-controls-right: 1rem;
      bottom: 4rem;
    }
  }

  @media (max-width: 768px) {
    .floating-controls-container {
      --floating-controls-right: 0.75rem;
      bottom: 4rem;
    }
    .floating-controls-container .koharu-music,
    .floating-controls-container #back-to-top-wrapper {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .floating-controls-container {
      --floating-controls-right: 0.5rem;
      bottom: 4rem;
    }
  }

  /* 高缩放比例适配 */
  @media (min-resolution: 2dppx) {
    .floating-controls-container {
      --floating-controls-right: max(0.5rem, 2rem - 2vw);
      bottom: max(3rem, 4rem - 5vh);
    }
  }
  
  /* 横屏模式适配 */
  @media (orientation: landscape) and (max-height: 500px) {
    .floating-controls-container {
      bottom: 4rem; 
    }
  }

  /* 极低分辨率适配 */
  @media (max-width: 320px) {
    .floating-controls-container {
        --floating-controls-right: 0.125rem;
        bottom: 4rem;
    }
  }
</style>
