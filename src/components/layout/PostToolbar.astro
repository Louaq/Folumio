---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getCategoryUrl } from "@/utils/category-utils";
import { url } from "@/utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
---

<div class="post-toolbar">
  <nav aria-label="面包屑导航" class="post-breadcrumb">
    <ol>
      <li><a href={url("/")}><Icon name="material-symbols:home-rounded" />{i18n(I18nKey.home)}</a></li>
      <li aria-hidden="true">›</li>
      <li><a href={getCategoryUrl(entry.data.category)}>{entry.data.category || i18n(I18nKey.uncategorized)}</a></li>
      <li aria-hidden="true">›</li>
      <li class="post-breadcrumb-current" aria-current="page" title={entry.data.title}>{entry.data.title}</li>
    </ol>
  </nav>
  {!entry.data.password && (
    <div class="markdown-actions" data-markdown={entry.body} data-title={entry.data.title}>
    <button type="button" id="post-copy-markdown">
      <Icon name="material-symbols:content-copy-outline-rounded" />
      <span data-copy-label aria-live="polite">复制 Markdown</span>
    </button>
    <details class="markdown-menu">
      <summary aria-label="更多 Markdown 操作"><Icon name="lucide:chevron-down" /></summary>
      <div class="markdown-menu-items">
        <button type="button" data-download-markdown><Icon name="lucide:download" />下载 .md</button>
        <a href={url("/studio/")} data-open-studio data-no-swup><Icon name="lucide:feather" />在写作室打开</a>
      </div>
    </details>
    </div>
  )}
</div>

<style>
  .post-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--juejin-text-primary);
  }
  .post-breadcrumb {
    min-width: 0;
    flex: 1 1 12rem;
  }
  ol {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    flex-shrink: 0;
  }
  a, button {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .post-breadcrumb-current, .markdown-actions {
    border-radius: 9999px;
    padding: 0.375rem 0.75rem;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }
  .post-breadcrumb-current {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  button {
    flex-shrink: 0;
    cursor: pointer;
    font: inherit;
    border: 0;
  }
  .markdown-actions { display: flex; align-items: stretch; padding: 0; position: relative; flex-shrink: 0; }
  #post-copy-markdown { padding: 0.375rem 0.75rem; background: transparent; }
  .markdown-menu summary { display: flex; align-items: center; height: 100%; padding: 0 0.5rem; border-left: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); cursor: pointer; list-style: none; }
  .markdown-menu summary::-webkit-details-marker { display: none; }
  .markdown-menu-items { position: absolute; top: calc(100% + 0.25rem); right: 0; z-index: 20; min-width: 10rem; padding: 0.375rem; border: 1px solid var(--line-divider); border-radius: 0.875rem; background: var(--card-bg); box-shadow: 0 2px 6px #0002; color: var(--juejin-text-primary); }
  .markdown-menu[open] .markdown-menu-items { animation: markdown-menu-open 180ms ease-out; transform-origin: top right; }
  @keyframes markdown-menu-open {
    from { opacity: 0; transform: translateY(-6px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .markdown-menu[open] .markdown-menu-items { animation: none; }
  }
  .markdown-menu-items :is(button, a) { width: 100%; gap: 0.5rem; padding: 0.5rem; border-radius: 0.5rem; background: transparent; white-space: nowrap; text-align: left; }
</style>
