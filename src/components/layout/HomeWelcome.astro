---
import CoverImage from "@/components/common/CoverImage.astro";
import { homeWelcomeConfig } from "@/config/homeWelcomeConfig";
import { url } from "@/utils/navigation";
---

<section class="home-welcome card-base overflow-hidden rounded-2xl shadow-xs border border-black/6 dark:border-white/10" aria-label={homeWelcomeConfig.eyebrow}>
  <div class:list={["welcome-front", { "has-cover": !!homeWelcomeConfig.image }]}>
    {homeWelcomeConfig.image ? (
      <CoverImage src={homeWelcomeConfig.image} alt="" preview={true} class="welcome-cover" />
    ) : (
      <svg class="welcome-art" viewBox="-150 -55 300 110" aria-hidden="true">
        <defs>
          <linearGradient id="welcome-hello-gradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#009aa7" />
            <stop offset="25%" stop-color="#9adb66" />
            <stop offset="42%" stop-color="#ffd600" />
            <stop offset="58%" stop-color="#ff8425" />
            <stop offset="76%" stop-color="#ed39be" />
            <stop offset="100%" stop-color="#3ebaf0" />
          </linearGradient>
        </defs>
        <path class="hello-stroke" pathLength="1" d=" M-136.5659942626953,38.12799835205078 C-119.71700286865234,27.10300064086914 -85.06099700927734,1.3079999685287476 -81.85099792480469,-26.16200065612793 C-79.42400360107422,-46.94300079345703 -98.572998046875,-44.137001037597656 -101.4260025024414,-23.01300048828125 C-103.75700378417969,-5.755000114440918 -109.59600067138672,40.56100082397461 -109.59600067138672,40.56100082397461 C-109.59600067138672,40.56100082397461 -103.97899627685547,-0.03400000184774399 -85.85099792480469,1.753000020980835 C-65.93599700927734,4.083000183105469 -91.97803497314453,40.04999923706055 -68.99903106689453,40.30500030517578 C-48.5720329284668,40.53200149536133 -27.638999938964844,22.687999725341797 -26.87299919128418,10.942999839782715 C-25.989999771118164,-2.5989999771118164 -44.36199951171875,-4.886000156402588 -50.02199935913086,11.965999603271484 C-55.22600173950195,27.461000442504883 -43.58399963378906,44.902000427246094 -23.540000915527344,40.58100128173828 C7.341000080108643,33.922000885009766 22.482999801635742,-10.82699966430664 23.93600082397461,-26.07699966430664 C25.466999053955078,-42.1619987487793 13.722999572753906,-43.694000244140625 6.573999881744385,-29.39699935913086 C-0.10400000214576721,-16.040000915527344 -11.244999885559082,37.084999084472656 12.958000183105469,41.58300018310547 C41.808998107910156,46.944000244140625 64.2770004272461,-5.906000137329102 67.08599853515625,-23.77899932861328 C69.802001953125,-41.066001892089844 58.65599822998047,-45.95199966430664 50.23400115966797,-30.67300033569336 C41.16600036621094,-14.222999572753906 27.843000411987305,44.07699966430664 59.9370002746582,41.32600021362305 C86.74600219726562,39.02799987792969 76.91600036621094,2.2639999389648438 102.89800262451172,-0.05000000074505806 C114.56199645996094,-1.0880000591278076 119.38600158691406,9.920000076293945 118.53199768066406,21.02899932861328 C117.63800048828125,32.645999908447266 106.66000366210938,42.474998474121094 95.80899810791016,40.94300079345703 C85.89800262451172,39.54399871826172 80.83799743652344,25.972999572753906 83.42500305175781,17.07200050354004 C86.61699676513672,6.093999862670898 96.66200256347656,0.11999999731779099 102.89800262451172,-0.05000000074505806 C111.76599884033203,-0.28999999165534973 116.23400115966797,5.327000141143799 124.14900207519531,5.198999881744385 C131.1790008544922,5.085999965667725 136.71173095703125,-1.3627643585205078 136.71173095703125,-1.3627643585205078" />
      </svg>
    )}
    <div class="welcome-copy">
      <p class="welcome-eyebrow">{homeWelcomeConfig.eyebrow}</p>
      <h2>{homeWelcomeConfig.title}</h2>
      <p class="welcome-description">{homeWelcomeConfig.description}</p>
    </div>
  </div>
    <a class="welcome-button" href={url("/about/")}>
      <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--tabler" width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M17 3.34a10 10 0 1 1-14.995 8.984L2 12l.005-.324A10 10 0 0 1 17 3.34M15 8H9l-.117.007A1 1 0 0 0 8 9l.007.117A1 1 0 0 0 9 10h3.584l-4.291 4.293l-.083.094a1 1 0 0 0 1.497 1.32L14 11.414V15l.007.117A1 1 0 0 0 16 15V9l-.007-.117l-.029-.149l-.035-.105l-.054-.113l-.071-.111a1 1 0 0 0-.097-.112l-.09-.08l-.096-.067l-.098-.052l-.11-.044l-.112-.03l-.126-.017z"></path></svg>
      <span>{homeWelcomeConfig.linkText}</span>
    </a>
</section>

<style>
  .home-welcome {
    position: relative;
    height: 300px;
    overflow: hidden;
    background: linear-gradient(115deg, #e5f7f3, #f5f5ff 56%, #fff6fa);
  }
  .welcome-front {
    position: absolute;
    inset: 0;
    display: block;
  }
  .welcome-art {
    position: absolute;
    inset: 8px 16px auto;
    height: 110px;
    width: calc(100% - 32px);
  }
  .hello-stroke {
    fill: none;
    stroke: url(#welcome-hello-gradient);
    stroke-width: 9.000005555780529;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: hello-write 3s linear both;
  }
  @keyframes hello-write {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  .home-welcome :global(.welcome-cover) {
    position: absolute;
    inset: 0;
    min-height: 0;
    height: 100%;
  }
  .has-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 20%, rgba(0, 0, 0, 0.75));
  }
  .welcome-copy {
    position: absolute;
    bottom: 72px;
    left: 20px;
    right: 20px;
    z-index: 1;
  }
  .welcome-eyebrow, .welcome-description {
    color: var(--content-meta);
    font-size: 12px;
    line-height: 1.6;
  }
  h2 {
    color: #249fa7;
    font-size: 22px;
    line-height: 1.35;
    font-weight: 700;
    margin: 4px 0;
  }
  .has-cover .welcome-copy :is(h2, p) { color: white; }
  .welcome-button {
    position: absolute;
    bottom: 20px;
    right: 20px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--line-divider);
    border-radius: 999px;
    background: var(--card-bg-transparent);
    backdrop-filter: blur(16px);
    color: #d94f83;
    font-size: 14px;
    cursor: pointer;
  }
  .welcome-button:hover { background: var(--primary); color: white; }
  :global(:root.dark) .home-welcome { background: linear-gradient(115deg, #183533, #27283b 56%, #352532); }
  :global(:root.dark) h2 { color: #69ccc7; }
  :global(:root.dark) .welcome-button { color: #f18ab0; }
  @media (max-width: 767px) {
    .home-welcome { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hello-stroke { animation: none; }
  }
</style>
