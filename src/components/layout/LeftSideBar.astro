---
import type { MarkdownHeading } from "astro";
import Announcement from "@/components/widget/Announcement.astro";
import Categories from "@/components/widget/Categories.astro";
import Profile from "@/components/widget/Profile.astro";
import SiteRuntime from "@/components/widget/SiteRuntime.astro";
import SiteStats from "@/components/widget/SiteStats.astro";
import Tags from "@/components/widget/Tags.astro";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getComponentStyle,
	getComponentsByPosition,
} from "@/utils/widget-manager";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	isPostPage?: boolean;
}

const { class: className, headings: _headings, isPostPage = false } = Astro.props;

const topComponents = getComponentsByPosition("top", isPostPage);
const stickyComponents = getComponentsByPosition("sticky", isPostPage);
const scrollingComponents = isPostPage
	? [...topComponents, ...stickyComponents.slice(0, -1)]
	: topComponents;
const pinnedComponents = isPostPage
	? stickyComponents.slice(-1)
	: stickyComponents;

const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	stats: SiteStats,
	runtime: SiteRuntime,
};

function renderComponent(
	component: WidgetComponentConfig,
	index: number,
	_components: WidgetComponentConfig[],
) {
	const ComponentToRender =
		componentMap[component.type as keyof typeof componentMap];
	if (!ComponentToRender) return null;

	return {
		Component: ComponentToRender,
		props: {
			class: component.class ?? "",
			style: getComponentStyle(component, index),
			headings: undefined,
			...component.customProps,
		},
	};
}
---

<div id="left-sidebar" class:list={[className, "w-full gap-5"]}>
  <!-- 随页面滚动的组件区域 -->
  {
    scrollingComponents.length > 0 && (
      <div class="flex flex-col w-full gap-5 shrink-0">
        {scrollingComponents.map((component, index) => {
          const renderData = renderComponent(component, index, scrollingComponents);
          if (!renderData) return null;

          const { Component, props } = renderData;
          return <Component {...props} />;
        })}
      </div>
    )
  }

  <!-- 组件组吸顶时避开固定导航栏，并保留 1rem 间距 -->
  {
    (pinnedComponents.length > 0 || isPostPage) && (
      <div
        id="left-sidebar-sticky"
        class="sticky top-[calc(var(--navbar-height)+1rem)] flex flex-col w-full gap-5 shrink-0"
      >
        {pinnedComponents.map((component, index) => {
          const renderData = renderComponent(
            component,
            index,
            pinnedComponents
          );
          if (!renderData) return null;

          const { Component, props } = renderData;
          return <Component {...props} />;
        })}
        {isPostPage && <slot />}
      </div>
    )
  }
</div>

<!-- 左侧边栏显示/隐藏由父布局传入的 Tailwind 类控制 -->
