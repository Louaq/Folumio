---
// Adapted from LyraVoid/Shirone BannerStage.astro (MIT).
import { siteConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";
import { getFileDirFromPath, getPostUrlForEntry, isHomePage } from "@/utils/navigation";
import { type BannerImage, resolveBannerImage } from "@/utils/banner-image";
import BannerWaves from "./BannerWaves.astro";
interface Props {
	title?: string;
	description?: string;
	metadata?: string;
	isPost?: boolean;
	cover?: BannerImage;
}
const { title, description, metadata, isPost, cover } = Astro.props;
const [desktop, mobile] = await Promise.all([
  resolveBannerImage(siteConfig.homeBanner.desktop),
  resolveBannerImage(siteConfig.homeBanner.mobile),
]);
const wallpaper = cover ?? desktop;
const posts = (await getSortedPosts())
  .filter((post) => post.data.homeCarousel && !post.data.draft)
  .sort((a, b) => (a.data.homeCarouselOrder ?? 0) - (b.data.homeCarouselOrder ?? 0));
const articleSlides = await Promise.all(posts.map(async (post) => {
  const image = post.data.homeCarouselImage
    ? await resolveBannerImage(post.data.homeCarouselImage)
    : post.data.image
      ? await resolveBannerImage(post.data.image, `/src/${getFileDirFromPath(post.filePath!)}`)
      : desktop;
  return { title: post.data.title, description: post.data.description, href: getPostUrlForEntry(post), image };
}));
const slides = [{ title: siteConfig.title, description: siteConfig.subtitle, href: "", image: desktop }, ...articleSlides];
const showCarousel = isHomePage(Astro.url.pathname) && slides.length > 1;
---
<section class:list={["banner-stage", { "banner-stage--carousel": slides.length > 1 }]} aria-label={title || siteConfig.title} data-default-desktop={JSON.stringify(desktop)} data-default-mobile={mobile.src}>
  <div class="banner-stage__media banner-stage__default" aria-hidden="true">
    <picture>
      <source media="(max-width: 1023px)" srcset={cover?.src ?? mobile.src} />
      <img
        class="banner-stage__image"
        src={wallpaper.src}
        width={wallpaper.width}
        height={wallpaper.height}
        alt=""
        fetchpriority={showCarousel ? "auto" : "high"}
        loading={showCarousel ? "lazy" : "eager"}
        decoding="async"
      />
    </picture>
  </div>
  <div class="banner-stage__scrim"></div>
  <div class="banner-stage__copy banner-stage__default">
    <h1 class="banner-stage__title" id={isPost ? "post-title" : undefined}>
      {title || siteConfig.title}
    </h1>
    <p>{description || siteConfig.subtitle}</p>
    <div class="banner-stage__metadata" set:html={metadata} />
  </div>
  {slides.length > 1 && (
    <div class="banner-carousel" role="region" aria-roledescription="轮播图" aria-label="精选文章">
      {slides.map((slide, index) => (
        <div class="banner-carousel__slide" data-slide hidden={index !== 0} role="group" aria-roledescription="幻灯片" aria-label={`${index + 1} / ${slides.length}`}>
          <div class="banner-stage__media" aria-hidden="true">
            <picture>
              {index === 0 && <source media="(max-width: 1023px)" srcset={mobile.src} />}
            <img class="banner-stage__image" src={slide.image.src} width={slide.image.width} height={slide.image.height} alt="" loading={showCarousel && index === 0 ? "eager" : "lazy"} fetchpriority={showCarousel && index === 0 ? "high" : "auto"} decoding="async" />
            </picture>
          </div>
          <div class:list={["banner-stage__copy", { "banner-carousel__copy": index > 0 }]}>
            {slide.href ? <h2><a href={slide.href}>{slide.title}</a></h2> : <h2 class="banner-stage__title">{slide.title}</h2>}
            <p>{slide.description}</p>
            {slide.href && <a class="banner-carousel__read" href={slide.href}>阅读文章 →</a>}
          </div>
        </div>
      ))}
    </div>
  )}
  <BannerWaves />
</section>

<script>
  const carousel = document.querySelector<HTMLElement>(".banner-carousel");
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    if (slides.length > 1) {
      let current = 0;
      const paused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      function show(index: number) {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => { slide.hidden = i !== current; });
      }
      window.setInterval(() => {
        if (!paused && !document.hidden && document.body.dataset.pageType === "home" && !carousel.matches(":hover, :focus-within")) {
          show(current + 1);
        }
      }, 12000);
    }
  }
</script>
<style>
  .banner-stage {
    position: relative;
    height: 65vh;
    margin-bottom: 1rem;
    overflow: hidden;
    background: var(--page-bg);
  }

  .banner-stage__media, .banner-stage__scrim, .banner-stage__copy {
    position: absolute;
    inset: 0;
  }

  .banner-carousel, .banner-carousel__slide {
    position: absolute;
    inset: 0;
  }

  .banner-carousel {
    display: none;
  }

  :global(body[data-page-type="home"]) .banner-carousel {
    display: block;
  }

  :global(body[data-page-type="home"]) .banner-stage--carousel .banner-stage__default {
    visibility: hidden;
  }

  .banner-carousel__copy h2 {
    max-width: 60rem;
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .banner-carousel__copy p {
    max-width: 48rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .banner-carousel__copy a {
    pointer-events: auto;
  }

  .banner-carousel__read {
    margin-top: 1.25rem;
    padding: .5rem 1rem;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: .5rem;
  }

  .banner-stage__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: center;
    animation: banner-zoom 12s ease-out alternate infinite;
  }

  .banner-carousel__slide[hidden] .banner-stage__image {
    animation: none;
  }

  .banner-stage__scrim {
    z-index: 1;
    background: rgb(0 0 0 / calc(.24 * .55));
    pointer-events: none;
  }

  :global(html.dark) .banner-stage__scrim {
    background: rgb(0 0 0 / .24);
  }

  .banner-stage__copy {
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 2rem;
    color: white;
    text-align: center;
    text-shadow: 0 2px 12px rgb(0 0 0 / .48);
    pointer-events: none;
  }

  .banner-stage__title {
    margin: 0;
    font-size: 5rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .banner-stage__copy p {
    margin-top: .75rem;
    font-size: 1.5rem;
  }

  .banner-stage__metadata {
    pointer-events: auto;
    max-width: 100%;
  }

  .banner-stage__metadata:empty {
    display: none;
  }

  .banner-stage__metadata :global(.banner-post-information) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: .5rem 1rem;
    margin-top: 1rem;
    font-size: .875rem;
  }

  .banner-stage__metadata :global(.banner-post-meta) {
    justify-content: center;
    gap: .5rem 1rem;
    color: white;
  }

  .banner-stage__metadata :global(.text-50), .banner-stage__metadata :global(.meta-icon) {
    color: white;
  }

  .banner-stage__metadata :global(.meta-icon) {
    width: 1rem;
    height: 1rem;
    margin-right: .375rem;
    background: transparent;
  }

  .banner-stage__metadata :global(.meta-icon svg) {
    font-size: 1rem;
  }

  .banner-stage__metadata :global(a[href*="/tags/"]) {
    padding: .125rem .5rem;
    border-radius: .25rem;
    background: rgb(255 255 255 / 20%);
  }

  @keyframes banner-zoom {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.10);
    }
  }

  @media (max-width:1023.98px) {
    .banner-stage {
      height: max(70vh, 28rem);
    }
    .banner-stage__title {
      font-size: 2.75rem;
    }
    .banner-stage__copy p {
      font-size: 1.125rem;
    }
  }

  @media (min-width:480px) and (max-width:767.98px) {
    .banner-stage {
      height: max(75vh, 31.25rem);
    }
  }

  @media (min-width:768px) and (max-width:1023.98px) {
    .banner-stage {
      height: max(70vh, 31.25rem);
    }
  }

  @media (prefers-reduced-motion:reduce) {
    .banner-stage__image {
      animation: none;
    }
  }
</style>
