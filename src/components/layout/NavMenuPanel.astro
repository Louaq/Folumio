---
import Icon from "@/components/common/Icon.astro";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { LinkPresets } from "@/constants/link-presets";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { getSortedPosts, getTagList, getCategoryList } from "@/utils/content-utils";
import { isNavPathActive, url } from "@/utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const processedLinks = Astro.props.links.map((link: NavBarLink) => ({
	...link,
	children: link.children
		?.map((child: NavBarLink | LinkPreset): NavBarLink | null => {
			if (child === undefined || child === null) {
				return null;
			}
			if (typeof child === "number") {
				if (child in LinkPresets) {
					const preset = LinkPresets[child as LinkPreset];
					if (preset?.url) {
						return preset;
					}
				}
				return null;
			}
			if (child && typeof child === "object" && child.url) {
				return child;
			}
			return null;
		})
		.filter(
			(child): child is NavBarLink => child !== null && child !== undefined,
		),
}));
const currentPath = Astro.url.pathname;
const [posts, tags, categories] = await Promise.all([
    getSortedPosts(), getTagList(), getCategoryList(),
]);
const stats = [
    { label: "文章", count: posts.length },
    { label: "标签", count: tags.length },
    { label: "分类", count: categories.length },
];
---
<div id="nav-menu-panel" class="float-panel-closed" inert aria-hidden="true">
    <div class="mobile-nav-profile">
        <a href={url('/about/')} aria-label={profileConfig.name} class="mobile-nav-avatar">
            <ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} width={108} height={108} class="h-full w-full object-cover" />
        </a>
        <dl class="mobile-nav-stats">
            {stats.map((stat) => (
                <div><dt>{stat.label}</dt><dd>{stat.count}</dd></div>
            ))}
        </dl>
        <svg class="mobile-nav-divider" viewBox="0 0 300 24" aria-hidden="true">
            <path d="M0 22 60 2h116l34 10h-30l-12-5H62L20 22Z" fill="currentColor" opacity=".35" />
            <path d="m90 12 34 10h116l60-20-20 0-42 15H132l-12-5Z" fill="currentColor" opacity=".7" />
        </svg>
    </div>
    <div class="mobile-nav-links">
    {processedLinks.map((link) => {
        const isCurrentLink = !link.external && isNavPathActive(currentPath, link.url);
        const hasActiveChild =
            link.children?.some((child) => !child.external && isNavPathActive(currentPath, child.url)) ?? false;

        return (
        <div class="mobile-menu-item">
            {link.children && link.children.length > 0 ? (
                <div class="mobile-dropdown" data-mobile-dropdown>
                    <button
                        class="group flex justify-between items-center py-3 px-3 rounded-xl gap-4 w-full text-left
                            transition-transform nav-menu-row"
                        data-mobile-dropdown-trigger
                        aria-expanded="false"
                    >
                        <div class:list={[
                            "flex items-center transition-transform text-base font-medium text-[#000000B3] dark:text-white/75",
                            hasActiveChild && "navbar-link-active",
                        ]}>
                            {link.icon && <Icon icon={link.icon} class="text-[1.35rem] mr-3" />}
                            {link.name}
                        </div>
                        <Icon icon="material-symbols:keyboard-arrow-down-rounded"
                              class="transition-transform text-[1.25rem] text-(--primary) mobile-dropdown-arrow duration-200"
                        />
                    </button>
                    <div class="mobile-submenu" data-mobile-submenu>
                        {link.children?.map((child) => {
                            if (!child || !child.url) {
                                return null;
                            }
                            const isChildCurrent =
                                !child.external && isNavPathActive(currentPath, child.url);
                            return (
                                <a href={child.external ? child.url : url(child.url)}
                                   class="group flex justify-between items-center py-2.5 pl-9 pr-3 rounded-xl gap-4
                                       transition-transform nav-menu-row"
                                   target={child.external ? "_blank" : null}
                                   data-nav-path={!child.external ? child.url : undefined}
                                >
                                    <div class:list={[
                                        "flex items-center transition-transform text-black/60 dark:text-white/60 font-medium",
                                        isChildCurrent && "navbar-link-active",
                                    ]} data-nav-active-target>
                                        {child.icon && <Icon icon={child.icon} class="text-[1.2rem] mr-3" />}
                                        {child.name}
                                    </div>
                                    {child.external && <Icon icon="fa6-solid:arrow-up-right-from-square"
                                          class="text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
                                    />}
                                </a>
                            );
                        })}
                    </div>
                </div>
            ) : (
                <a href={link.external ? link.url : url(link.url)} class="group flex justify-between items-center py-3 px-3 rounded-xl gap-4
                    transition-transform nav-menu-row
                "
                   target={link.external ? "_blank" : null}
                   data-nav-path={!link.external ? link.url : undefined}
                >
                    <div class:list={[
                        "flex items-center transition-transform text-base font-medium text-[#000000B3] dark:text-white/75",
                        isCurrentLink && "navbar-link-active",
                    ]} data-nav-active-target>
                        {link.icon && <Icon icon={link.icon} class="text-[1.35rem] mr-3" />}
                        {link.name}
                    </div>
                    {link.external && <Icon icon="fa6-solid:arrow-up-right-from-square"
                          class="text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
                    />}
                </a>
            )}
        </div>
        );
    })}
    </div>
</div>
<button id="nav-menu-backdrop" type="button" aria-label="关闭导航菜单" tabindex="-1"></button>

<style>
    /* Tailwind v4：组件级 <style> 内使用 @apply 需先 @reference 取得 utilities 上下文 */
    @reference "tailwindcss";

    #nav-menu-panel {
        position: fixed;
        inset: 0 auto 0 0;
        z-index: 50;
        width: min(80vw, 360px);
        height: 100dvh;
        overflow-y: auto;
        overscroll-behavior: contain;
        background: var(--page-bg);
        color: var(--juejin-text-primary);
        transform: translateX(0);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, visibility 0.3s;
    }
    #nav-menu-panel.float-panel-closed {
        transform: translateX(-100%);
        visibility: hidden;
    }
    #nav-menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 40;
        background: rgb(0 0 0 / .75);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .3s ease;
    }
    #nav-menu-panel:not(.float-panel-closed) ~ #nav-menu-backdrop {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    :global(body:has(#nav-menu-panel:not(.float-panel-closed))) {
        overflow: hidden;
    }
    .mobile-nav-profile {
        padding: 24px 0 18px;
    }
    .mobile-nav-avatar {
        display: block;
        width: 108px;
        height: 108px;
        overflow: hidden;
        margin: 0 auto 24px;
        border-radius: 50%;
    }
    .mobile-nav-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        text-align: center;
        font-size: 16px;
        line-height: 1.6;
        margin: 0 8px 24px;
    }
    .mobile-nav-stats dd {
        margin: 6px 0 0;
        font-size: 20px;
    }
    .mobile-nav-divider {
        width: 100%;
        height: 24px;
        color: #55bed8;
    }
    .mobile-nav-links {
        padding: 0 8px 24px;
    }
    .nav-menu-row {
        min-height: 52px;
        border: 1px solid transparent;
        border-radius: 4px;
    }
    .nav-menu-row [data-nav-active-target],
    .nav-menu-row > div {
        font-size: 18px;
    }

    .nav-menu-row:hover,
    .nav-menu-row:active {
        background-color: color-mix(in oklch, #7bc5ed 70%, transparent);
    }

    .mobile-submenu {
        @apply max-h-0 overflow-hidden transition-all duration-300 ease-in-out;
    }
    
    .mobile-dropdown[data-expanded="true"] .mobile-submenu {
        @apply max-h-96;
    }
    
    .mobile-dropdown[data-expanded="true"] .mobile-dropdown-arrow {
        @apply rotate-180;
    }

    .mobile-menu-item a,
    .mobile-menu-item button {
        -webkit-tap-highlight-color: transparent;
    }

    #nav-menu-panel .navbar-link-active {
        color: #334155 !important;
    }

    .mobile-menu-item [data-nav-path].navbar-link-active [data-nav-active-target] {
        color: #334155 !important;
    }
    @media (min-width: 1024px) {
        #nav-menu-panel, #nav-menu-backdrop {
            display: none;
        }
        :global(body:has(#nav-menu-panel:not(.float-panel-closed))) {
            overflow: auto;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        #nav-menu-panel, #nav-menu-backdrop {
            transition: none;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const mobileDropdowns = document.querySelectorAll('[data-mobile-dropdown]');
        
        mobileDropdowns.forEach(dropdown => {
            const trigger = dropdown.querySelector('[data-mobile-dropdown-trigger]');
            const submenu = dropdown.querySelector('[data-mobile-submenu]');
            
            if (!trigger || !submenu) return;
            
            trigger.addEventListener('click', function(e) {
                e.preventDefault();
                const isExpanded = dropdown.getAttribute('data-expanded') === 'true';
                
                mobileDropdowns.forEach(otherDropdown => {
                    if (otherDropdown !== dropdown) {
                        otherDropdown.setAttribute('data-expanded', 'false');
                        const otherTrigger = otherDropdown.querySelector('[data-mobile-dropdown-trigger]');
                        if (otherTrigger) {
                            otherTrigger.setAttribute('aria-expanded', 'false');
                        }
                    }
                });
                
                const newState = !isExpanded;
                dropdown.setAttribute('data-expanded', newState.toString());
                trigger.setAttribute('aria-expanded', newState.toString());
            });
        });

        // 导航栏不会随 Swup 切换内容而重建，选择导航项后主动关闭菜单。
        const panel = document.getElementById('nav-menu-panel');
        const menuButton = document.getElementById('nav-menu-switch');
        const syncMenuState = () => {
            const closed = panel!.classList.contains('float-panel-closed');
            panel!.inert = closed;
            panel!.setAttribute('aria-hidden', String(closed));
            menuButton!.setAttribute('aria-expanded', String(!closed));
        };
        new MutationObserver(syncMenuState).observe(panel!, { attributes: true, attributeFilter: ['class'] });
        syncMenuState();
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !panel!.classList.contains('float-panel-closed')) {
                panel!.classList.add('float-panel-closed');
                menuButton!.focus();
            }
        });
        panel?.addEventListener('click', function(e) {
            const target = e.target;
            if (!(target instanceof Element)) return;
            const link = target.closest('a[href]');
            if (link) {
                panel.classList.add('float-panel-closed');
            }
        });
    });
</script>
