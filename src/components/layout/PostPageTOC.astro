---
import type { MarkdownHeading } from "astro";
import "@/styles/toc.css";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	headings: MarkdownHeading[];
	class?: string;
	style?: string;
}

const { headings: _headings = [], class: className, style } = Astro.props;
---

<details class:list={["post-page-toc-wrap", className]} style={style}>
  <summary class="post-page-toc-toggle" aria-label={i18n(I18nKey.tableOfContents)} title={i18n(I18nKey.tableOfContents)}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
      <path d="M2 5h20M2 12h20M2 19h20" />
    </svg>
  </summary>
  <nav class="post-page-toc-panel" aria-label={i18n(I18nKey.tableOfContents)}>
    <div class="toc-scroll-container">
      <div class="toc-content" id="post-page-toc-content">
        <!-- Generated by TOCManager from article headings. -->
      </div>
    </div>
  </nav>
</details>

<style>
.post-page-toc-wrap {
  position: relative;
  pointer-events: auto;
  color: var(--juejin-text-primary);
}

.post-page-toc-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  list-style: none;
  cursor: pointer;
  background: transparent;
  color: var(--primary);
}

.post-page-toc-toggle::-webkit-details-marker {
  display: none;
}

.post-page-toc-panel {
  width: min(18rem, calc(100vw - 2rem));
  position: fixed;
  right: 1.5rem;
  --toc-top: max(6rem, calc(var(--post-hero-bottom) + 1.5rem));
  top: var(--toc-top);
  padding: 1rem;
  border-radius: var(--radius-large);
  background: var(--card-bg);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.14);
}

.post-page-toc-wrap .toc-scroll-container {
  max-height: calc(100dvh - var(--toc-top) - 4rem);
}

.post-page-toc-wrap :global(.toc-item) {
  align-items: flex-start;
}

.post-page-toc-wrap :global(.toc-label) {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
}

@media (max-width: 767px) {
  .post-page-toc-wrap {
    display: none;
  }
}
</style>
