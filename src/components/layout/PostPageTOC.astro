---
import type { MarkdownHeading } from "astro";
import "@/styles/toc.css";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	headings: MarkdownHeading[];
	class?: string;
	style?: string;
}

const { headings: _headings = [], class: className, style } = Astro.props;
---

<aside class:list={["post-page-toc-wrap", className]} style={style}>
  <nav class="post-page-toc-panel" aria-label={i18n(I18nKey.tableOfContents)}>
    <div class="toc-scroll-container">
      <div class="toc-content" id="post-page-toc-content">
        <!-- Generated by TOCManager from article headings. -->
      </div>
    </div>
  </nav>
</aside>

<style>
.post-page-toc-wrap {
  display: none;
  min-width: 0;
  color: var(--juejin-text-primary);
}

.post-page-toc-panel {
  position: sticky;
  top: 6rem;
}

.toc-scroll-container {
  max-height: calc(100dvh - 8rem);
  border-left: 1px solid var(--line-divider);
}

.post-page-toc-wrap :global(.toc-content) {
  padding: 0;
}

.post-page-toc-wrap :global(.toc-row) {
  padding-bottom: 0;
}

.post-page-toc-wrap :global(.toc-item) {
  align-items: flex-start;
  min-height: 0;
  border-radius: 0;
  padding: 0.2rem 0.6rem;
}

.post-page-toc-wrap :global(.toc-item.toc-level-1) {
  padding-left: 1.2rem;
}

.post-page-toc-wrap :global(.toc-item.toc-level-2) {
  padding-left: 1.8rem;
}

.post-page-toc-wrap :global(.toc-label) {
  color: var(--juejin-text-primary);
  font-size: 0.875rem;
  line-height: 1.4;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
}

.post-page-toc-wrap :global(.toc-item.active::before) {
  top: 0;
  height: 100%;
  width: 2px;
  border-radius: 0;
  transform: none;
}

@media (min-width: 1280px) {
  .post-page-toc-wrap {
    display: block;
    padding-top: 1.5rem;
  }
}
</style>
