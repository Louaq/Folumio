---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { footerConfig, profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();

// 访客计数（Vercount）：默认关闭，由 footerConfig.visitorCount 开启
const visitorCount = footerConfig.visitorCount;
const showSitePv = Boolean(visitorCount?.enable && visitorCount.showSitePv);
const showSiteUv = Boolean(visitorCount?.enable && visitorCount.showSiteUv);
const showVisitorCount = showSitePv || showSiteUv;
const visitorApiUrl =
	visitorCount?.apiUrl || "https://events.vercount.one/api/v2/log";

let customFooterHtml = "";
if (footerConfig.enable) {
	try {
		const footerConfigPath = path.join(
			process.cwd(),
			"src",
			"config",
			"FooterConfig.html",
		);
		customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
		customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
	} catch (error) {
		console.warn(
			"FooterConfig.html文件读取失败:",
			error instanceof Error ? error.message : error,
		);
	}
}
---

<footer class="site-footer">
  <div class="footer-inner">
  <div class="footer-information">
    <div class="footer-copyright">
      <span>&copy; <span id="copyright-year">{currentYear}</span> By <a href={url("/about/")}>{profileConfig.name}</a></span>
      <span class="footer-powered">
        Powered by
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        &amp;
        <a href="https://github.com/Louaq/Folumio" target="_blank" rel="noopener noreferrer">Folumio</a>
      </span>
    </div>
    {
      customFooterHtml && (
        <div
          class="footer-custom"
          set:html={customFooterHtml}
        />
      )
    }
    <div class="footer-meta">
      <span
        class="inline-flex items-center gap-2"
      >
        <span>Supported by</span>
        <a
          class="inline-flex items-center gap-1 text-(--primary) font-medium"
          target="_blank"
          rel="noopener noreferrer"
          href="https://cloud.tencent.com/"
          aria-label="腾讯云"
        >
          <img
            src={url("/assets/images/tencent-cloud.svg")}
            alt=""
            width={80}
            height={18}
            class="h-[18px] w-20 shrink-0"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
        </a>
      </span>
      {
        showVisitorCount && (
          <span
            class="hidden flex-wrap items-center gap-x-3 gap-y-1"
            data-visitor-count
            data-api-url={visitorApiUrl}
          >
            {showSitePv && (
              <span class="inline-flex items-center gap-1">
                <Icon
                  name="material-symbols:visibility-outline-rounded"
                  is:inline
                  class="text-base text-(--primary)"
                />
                <span class="text-50">{i18n(I18nKey.visitorSitePv)}</span>
                <span
                  class="font-medium text-(--primary) tabular-nums"
                  data-visitor-value="site_pv"
                />
              </span>
            )}
            {showSiteUv && (
              <span class="inline-flex items-center gap-1">
                <Icon
                  name="material-symbols:person-outline-rounded"
                  is:inline
                  class="text-base text-(--primary)"
                />
                <span class="text-50">{i18n(I18nKey.visitorSiteUv)}</span>
                <span
                  class="font-medium text-(--primary) tabular-nums"
                  data-visitor-value="site_uv"
                />
              </span>
            )}
          </span>
        )
      }
    </div>
  </div>
  <div class="footer-links">
    <nav class="footer-friend-links" aria-label="友链集合">
      <a href="https://www.foreverblog.cn/go.html" target="_blank" rel="noopener noreferrer" title="WORMHOLE · 穿梭虫洞">
        <img src={url("/assets/images/wormhole_4_tp.gif")} alt="WORMHOLE" width="80" height="22" loading="lazy" decoding="async" />
      </a>
      <a href="https://www.travellings.cn/go.html" target="_blank" rel="noopener noreferrer" title="Travelling · 开往友链接力">
        <img src={url("/assets/images/kaiwang.gif")} alt="Travelling" width="80" height="20" loading="lazy" decoding="async" />
      </a>
    </nav>
  <nav class="footer-navigation" aria-label="页脚导航">
    <a href={url("/about/")}>关于</a>
    <a href="https://github.com/Louaq/Folumio" target="_blank" rel="noopener noreferrer">框架</a>
    <a href={url("/")}>主页</a>
    <a href={url("/rss.xml")} data-no-swup aria-label="RSS 订阅" title="RSS 订阅"><Icon name="lucide:rss" /></a>
    <a href={url("/sitemap.xml")} data-no-swup aria-label="站点地图" title="站点地图"><Icon name="lucide:map" /></a>
  </nav>
  </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 32px;
    background-color: #f7f7f9;
    border-top: 1px solid var(--line-divider);
    color: var(--content-meta);
    font-size: 14px;
    line-height: 1.8;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 24px 16px;
  }
  .footer-information { min-width: 0; }
  .footer-copyright, .footer-meta, .footer-powered {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .footer-copyright > span > a { color: var(--juejin-text-primary); font-weight: 700; }
  .footer-powered { gap: 4px; }
  .footer-powered a { color: var(--primary); }
  .footer-meta { margin-top: 4px; }
  .footer-custom { margin-top: 4px; }
  .footer-links { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 16px; }
  .footer-friend-links { display: flex; align-items: center; gap: 8px; }
  .footer-friend-links a { display: inline-flex; }
  .footer-friend-links img { display: block; width: 80px; height: auto; }
  :global(:root.dark) .footer-friend-links img { filter: invert(1); }
  .footer-navigation { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; flex-shrink: 0; color: var(--juejin-text-primary); }
  .footer-navigation a { display: inline-flex; align-items: center; font-weight: 600; }
  .footer-navigation :global(svg) { width: 18px; height: 18px; }
  .site-footer a { transition: color 200ms ease; }
  .site-footer a:hover { color: var(--primary); }
  :global(:root.dark) .site-footer { background-color: #20222a; }
  @media (max-width: 767px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 16px; padding: 20px 8px; }
    .footer-links { align-self: flex-end; }
  }
</style>

<script>
  const API_FALLBACK = "https://events.vercount.one/api/v2/log";
  const STORAGE_KEY = "visitorCountData";
  const UV_COOKIE_PREFIX = "vercount_uv_";
  const REQUEST_TIMEOUT = 5000;

  type Counts = { site_pv: number; page_pv: number; site_uv: number };

  const uvCookieName = () => {
    const host = window.location.host || "unknown-host";
    return `${UV_COOKIE_PREFIX}${host.replace(/[^a-zA-Z0-9_-]/g, "_")}`;
  };

  const hasUvCookie = () =>
    document.cookie
      .split("; ")
      .some((entry) => entry === `${uvCookieName()}=1`);

  const setUvCookie = () => {
    document.cookie = `${uvCookieName()}=1; path=/; max-age=31536000; samesite=lax`;
  };

  // 接口成功时数据在 data 字段下，失败/旧版本则直接平铺在顶层
  const normalize = (payload: any): Counts => {
    const data = payload?.data ?? payload ?? {};
    return {
      site_pv: Number(data.site_pv ?? 0),
      page_pv: Number(data.page_pv ?? 0),
      site_uv: Number(data.site_uv ?? 0),
    };
  };

  const readCache = (requestKey: string): Counts | null => {
    try {
      const raw = localStorage.getItem(`${STORAGE_KEY}:${requestKey}`);
      return raw ? normalize(JSON.parse(raw)) : null;
    } catch {
      return null;
    }
  };

  const writeCache = (requestKey: string, counts: Counts) => {
    try {
      localStorage.setItem(`${STORAGE_KEY}:${requestKey}`, JSON.stringify(counts));
    } catch {
      // localStorage 不可用（隐私模式等）时忽略，下次访问重新拉取
    }
  };

  // 统一更新正文与页脚中的访问统计
  const render = (counts: Counts, includePageViews = true) => {
    for (const el of document.querySelectorAll<HTMLElement>(
      "[data-visitor-value]",
    )) {
      if (!includePageViews && el.dataset.visitorValue === "page_pv") continue;
      const value = counts[el.dataset.visitorValue as keyof Counts];
      if (typeof value === "number") el.textContent = value.toLocaleString();
    }
    for (const el of document.querySelectorAll("[data-visitor-count]")) {
      el.classList.remove("hidden");
      el.classList.add("inline-flex");
    }
  };

  let inFlight = false;
  let lastRequestKey = "";
  let lastRequestAt = 0;
  let lastCounts: Counts | null = null;
  const SAME_PAGE_REQUEST_TTL = 60_000;

  const refresh = async () => {
    const root = document.querySelector<HTMLElement>(
      "[data-page-visitor-count], [data-visitor-count]",
    );
    if (!root || inFlight) return;
    inFlight = true;

    const requestKey = `${window.location.pathname}${window.location.search}`;
    const cached = readCache(requestKey);
    if (cached) render(cached, false);

    const now = Date.now();
    if (
      lastCounts &&
      requestKey === lastRequestKey &&
      now - lastRequestAt < SAME_PAGE_REQUEST_TTL
    ) {
      render(lastCounts);
      inFlight = false;
      return;
    }
    for (const el of document.querySelectorAll('[data-visitor-value="page_pv"]')) {
      el.textContent = "...";
    }

    // 首次访问才计入 UV，与官方脚本共用同一个 cookie
    const isNewUv = !hasUvCookie();
    if (isNewUv) setUvCookie();

    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT);
    try {
      const response = await fetch(root.dataset.apiUrl || API_FALLBACK, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url: window.location.href, isNewUv }),
        signal: controller.signal,
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const counts = normalize(await response.json());
      lastRequestKey = requestKey;
      lastRequestAt = Date.now();
      lastCounts = counts;
      if (requestKey === `${window.location.pathname}${window.location.search}`) {
        render(counts);
      }
      writeCache(requestKey, counts);
    } catch (error) {
      // 接口不可用时文章保持占位符，页脚沿用缓存值或保持隐藏
      console.warn("访客计数接口请求失败:", error);
    } finally {
      clearTimeout(timer);
      inFlight = false;
      if (requestKey !== `${window.location.pathname}${window.location.search}`) {
        void refresh();
      }
    }
  };

  refresh();
  document.addEventListener("astro:page-load", refresh);
</script>
