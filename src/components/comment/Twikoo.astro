---
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";
const config = commentConfig.twikoo;

const twikooScriptUrl = url("/assets/js/twikoo-2.0.9.all.min.js");
const twikooCssUrl = url("/assets/css/twikoo.css");
---

<div id="tcomment"></div>
<script is:inline define:vars={{ config, twikooScriptUrl, twikooCssUrl }}>
  function getCurrentPath() {
    const pathname = window.location.pathname;
    return pathname.endsWith("/") && pathname.length > 1
      ? pathname.slice(0, -1)
      : pathname;
  }

  function createTwikooConfig() {
    return {
      ...config,
      path: getCurrentPath(),
      el: "#tcomment",
    };
  }

  function loadTwikooCss() {
    if (!document.getElementById("twikoo-css")) {
      const link = document.createElement("link");
      link.id = "twikoo-css";
      link.rel = "stylesheet";
      link.href = twikooCssUrl;
      document.head.appendChild(link);
    }
  }

  let styleBaseline = null;
  function snapshotHeadStyles() {
    styleBaseline = new Set(document.head.querySelectorAll("style"));
  }
  function markTwikooStyles() {
    if (!styleBaseline) {
      return;
    }
    for (const el of document.head.querySelectorAll("style")) {
      if (!styleBaseline.has(el)) {
        el.setAttribute("data-twikoo-style", "");
      }
    }
  }

  let twikooScriptPromise = null;
  function loadTwikooScript() {
    loadTwikooCss();
    if (typeof twikoo !== "undefined") {
      return Promise.resolve();
    }
    if (twikooScriptPromise) {
      return twikooScriptPromise;
    }
    snapshotHeadStyles();
    twikooScriptPromise = new Promise(function (resolve, reject) {
      const existing = document.getElementById("twikoo-script");
      if (existing) {
        existing.addEventListener("load", resolve, { once: true });
        existing.addEventListener("error", reject, { once: true });
        return;
      }
      const script = document.createElement("script");
      script.id = "twikoo-script";
      script.defer = true;
      script.src = twikooScriptUrl;
      script.addEventListener("load", resolve, { once: true });
      script.addEventListener("error", function (e) {
        twikooScriptPromise = null; // 允许后续重试
        reject(e);
      }, { once: true });
      document.head.appendChild(script);
    });
    return twikooScriptPromise;
  }

  function initTwikoo() {
    const commentEl = document.getElementById("tcomment");
    if (!commentEl) {
      return;
    }
    loadTwikooScript()
      .then(function () {
        commentEl.innerHTML = "";
        const initialized = twikoo.init(createTwikooConfig());
        // init 同步注入的样式先标记一次，异步补注入的在 resolve 后再标记
        markTwikooStyles();
        return initialized;
      })
      .then(markTwikooStyles)
      .catch(function (error) {
        console.warn("Twikoo 评论区加载失败:", error);
      });
  }

  // 当评论区接近视口时才加载脚本并初始化
  function observeAndInit() {
    const commentEl = document.getElementById("tcomment");
    if (!commentEl) {
      return;
    }
    if (typeof twikoo !== "undefined") {
      initTwikoo();
      return;
    }
    const observer = new IntersectionObserver(
      function (entries, obs) {
        if (entries.some((entry) => entry.isIntersecting)) {
          obs.disconnect();
          initTwikoo();
        }
      },
      { rootMargin: "800px 0px" },
    );
    observer.observe(commentEl);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", observeAndInit);
  } else {
    observeAndInit();
  }
</script>
