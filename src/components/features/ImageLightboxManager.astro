---
// 全局监听图片点击，按需加载 Shirone 的 Fancybox 预览；兼容 Swup 页面切换。
---

<script>
  const selector = ".custom-md img, #post-cover img, .moment-images img, .essay-images img";
  let viewer: typeof import("@/utils/image-lightbox") | undefined;
  let loading: Promise<typeof import("@/utils/image-lightbox")> | undefined;
  let visit = 0;

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLImageElement) || !target.matches(selector)) return;
    event.preventDefault();
    const token = ++visit;
    const group = target.closest(".moment-images, .essay-images") ?? document;
    const elements = Array.from(group.querySelectorAll<HTMLImageElement>(selector));
    const images = elements.map(
      (image) => {
        const anchor = image.closest<HTMLAnchorElement>("a[data-fancybox]");
        return {
          src: image.dataset.zoomSrc || anchor?.dataset.src || anchor?.href || image.currentSrc || image.src,
          thumbSrc: image.currentSrc || image.src,
          thumbEl: image,
          caption: image.alt.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;"),
        };
      },
    );
    const currentIndex = elements.indexOf(target);
    loading ??= import("@/utils/image-lightbox");
    viewer = await loading;
    if (token !== visit) return;
    viewer.open(images, currentIndex);
  }, { capture: true });

  document.addEventListener("swup:visit:start", () => {
    visit++;
    viewer?.close();
  });
</script>
