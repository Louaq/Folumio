---
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlForEntry } from "@/utils/navigation";

const protectedPosts = (await getSortedPosts())
  .filter((post) => post.data.password)
  .map((post) => [getPostUrlForEntry(post).replace(/\/$/, ""), post.id]);
---

<script id="protected-posts" type="application/json" is:inline set:html={JSON.stringify(protectedPosts).replace(/</g, "\\u003c")} />

<script>
  import { flushSync, mount, unmount } from "svelte";
  import PasswordProtection from "@/components/misc/PasswordProtection.svelte";

  const posts = new Map<string, string>(JSON.parse(document.getElementById("protected-posts")!.textContent!));
  const unlocked = new Map<string, string>();
  let dismiss: (() => void) | undefined;
  const pathKey = (pathname: string) => pathname.replace(/\/$/, "");

  function revealContent() {
    const element = document.getElementById("protected-content");
    const html = unlocked.get(pathKey(location.pathname));
    if (!element || html === undefined || element.dataset.unlocked) return;

    element.dataset.unlocked = "true";
    element.innerHTML = html;
    // Scripts inserted through innerHTML need new nodes to execute.
    for (const oldScript of Array.from(element.querySelectorAll("script"))) {
      const script = document.createElement("script");
      for (const attribute of Array.from(oldScript.attributes)) {
        script.setAttribute(attribute.name, attribute.value);
      }
      script.textContent = oldScript.textContent;
      oldScript.replaceWith(script);
    }
    element.style.display = "block";
    document.dispatchEvent(new Event("astro:page-load"));
  }

  function openPassword(href: string, event: Event) {
    const destination = new URL(href, location.href);
    const path = pathKey(destination.pathname);
    const postId = posts.get(path);
    if (destination.origin !== location.origin || !postId) return;
    if (unlocked.has(path)) return;

    event.preventDefault();
    event.stopImmediatePropagation();
    if (dismiss) return;

    const host = document.createElement("div");
    document.body.append(host);
    const content = fetch(destination.href)
      .then((response) => response.text())
      .then((html) => new DOMParser().parseFromString(html, "text/html").getElementById("protected-content")!);

    const close = () => {
      void unmount(component);
      host.remove();
      dismiss = undefined;
    };
    const component = mount(PasswordProtection, {
      target: host,
      props: {
        postId,
        content,
        onCancel: close,
        onUnlock: (html: string) => {
          unlocked.set(path, html);
          close();
          window.swup.navigate(destination.pathname + destination.search + destination.hash);
        },
      },
    });
    dismiss = close;
    flushSync();
  }

  document.addEventListener("click", (event) => {
    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    const target = event.target as Element;
    const anchor = target.closest<HTMLAnchorElement>("a[href]");
    if (anchor) {
      if (anchor.target === "_blank" || anchor.hasAttribute("download")) return;
      openPassword(anchor.href, event);
      return;
    }
    if (target.closest("button, input, textarea, select, label, [role='button']")) return;
    const card = target.closest<HTMLElement>(".post-card-wrapper[data-url]");
    if (card && !window.getSelection()?.toString()) openPassword(card.dataset.url!, event);
  }, { capture: true });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    const target = event.target as HTMLElement;
    if (target.matches(".post-card-wrapper[data-url]")) openPassword(target.dataset.url!, event);
  }, { capture: true });

  document.addEventListener("swup:visit:start", () => dismiss?.());
  document.addEventListener("astro:page-load", revealContent);
  revealContent();
</script>
