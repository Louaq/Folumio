---
import Footer from "@components/layout/Footer.astro";
import LeftSideBar from "@components/layout/LeftSideBar.astro";
import Navbar from "@components/layout/Navbar.astro";
import HomeBanner from "@components/layout/HomeBanner.astro";
import type { MarkdownHeading } from "astro";
import IconifyLoader from "@/components/misc/IconifyLoader.astro";
import { siteConfig } from "@/config";
import { showSidebarOnMobile } from "@/utils/widget-manager";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	hideSidebar?: boolean;
	wideContent?: boolean;
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
	hideSidebar = false,
	wideContent = false,
} = Astro.props;

const isPostPageCheck = postSlug !== undefined;
const bannerMetadata = await Astro.slots.render("banner-metadata");

const isSingleColumnLayout = hideSidebar || isPostPageCheck;
const PostPageTOC = isPostPageCheck
	? (await import("@components/layout/PostPageTOC.astro")).default
	: null;

const gridCols = isSingleColumnLayout
	? "grid-cols-1"
	: "grid-cols-1 lg:grid-cols-[17rem_minmax(0,1fr)]";

---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} whiteBackground={hideSidebar}>


<IconifyLoader />


<slot slot="head" name="head"></slot>
<div id="top-row" data-over-hero="true" class="z-50 pointer-events-none fixed top-0 left-0 right-0 transition-[opacity,transform] duration-700">
    <div id="navbar-wrapper" class="pointer-events-auto transition-[opacity,transform] duration-700">
        <Navbar></Navbar>
    </div>
</div>


<div class="absolute top-0 w-full z-30 pointer-events-none site-banner-layout">
    <div id="home-banner-wrapper">
        <HomeBanner title={title} description={description} metadata={bannerMetadata} isPost={isPostPageCheck} />
    </div>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative w-full max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid" class={`w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!showSidebarOnMobile ? 'mobile-no-sidebar' : ''}`}
        >
            <div id="left-sidebar-wrapper" class="contents">
                {!isSingleColumnLayout && (
                    <LeftSideBar
                        headings={headings}
                        isPostPage={isPostPageCheck}
                        class="hidden lg:flex lg:flex-col lg:row-start-[var(--content-row)] lg:row-span-1 lg:col-start-1 lg:col-end-2 lg:self-stretch transition-swup-fade transition-main"
                    />
                )}
            </div>

            {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
            <main id="swup-container" class:list={[
                "overflow-hidden w-full min-w-0 transition-swup-fade transition-main",
                isSingleColumnLayout
                    ? wideContent
                        ? "max-w-none mx-auto"
                        : "max-w-[calc(var(--page-width)-18rem)] mx-auto"
                    : "lg:row-start-[var(--content-row)] lg:col-start-2 lg:col-end-3",
            ]}>
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} data-white-bg={String(hideSidebar)} data-banner-title={title || siteConfig.title} data-banner-description={description || siteConfig.subtitle} class="hidden"></div>
                <template id="banner-metadata-template" set:html={bannerMetadata} />
                <div id="content-wrapper" class:list={{ "onload-animation": !isPostPageCheck }}>
                    {isPostPageCheck ? (
                        <div class="post-content-layout">
                            <div class="min-w-0"><slot /></div>
                            {PostPageTOC && <PostPageTOC headings={headings} />}
                        </div>
                    ) : <slot />}
                </div>
            </main>

            {/* 占位容器：保留 swup container 不变 */}
            <div id="right-sidebar-static" class="hidden"></div>
            <div id="right-sidebar-dynamic" class="hidden"></div>

        </div>
    </div>
    <div class="footer pointer-events-auto transition-swup-fade transition-main">
        <Footer />
    </div>
</div>

</Layout>

<style is:global>
  .site-banner-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .site-banner-layout > .relative {
    flex: 1;
  }
  #main-grid {
    --content-row: 1;
  }

  :root:not(.dark):has(body[data-page-type="post"]) {
    background-color: #f9f9f9 !important;
  }
  :root:not(.dark) body[data-page-type="post"] {
    background-color: #f9f9f9 !important;
  }

  :root:not(.dark):has(body[data-white-bg="true"]) {
    background-color: #f9f9f9 !important;
  }
  body[data-white-bg="true"] {
    background-color: transparent !important;
  }

  /* 右侧栏平滑过渡 */
  body[data-page-type="post"] #swup-container {
    grid-column: 1 / -1;
    max-width: calc(var(--page-width) - 18rem);
    margin-inline: auto;
  }

  @media (min-width: 90rem) {
    body[data-page-type="post"] #swup-container {
      overflow: visible;
    }
    .post-content-layout {
      position: relative;
    }
  }

  #right-sidebar {
    transition: opacity 0.35s ease-in-out, 
                transform 0.35s ease-in-out;
  }

</style>

