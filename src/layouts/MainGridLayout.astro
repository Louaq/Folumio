---
import Footer from "@components/layout/Footer.astro";
import LeftSideBar from "@components/layout/LeftSideBar.astro";
import Navbar from "@components/layout/Navbar.astro";
import type { MarkdownHeading } from "astro";
import IconifyLoader from "@/components/misc/IconifyLoader.astro";
import { siteConfig } from "@/config";
import { isHomePage } from "@/utils/layout-utils";
import { showSidebarOnMobile } from "@/utils/widget-manager";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	hideSidebar?: boolean;
	wideContent?: boolean;
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
	hideSidebar = false,
	wideContent = false,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPageCheck = postSlug !== undefined;

const isSingleColumnLayout = hideSidebar || isPostPageCheck;
const PostPageTOC = isPostPageCheck
	? (await import("@components/layout/PostPageTOC.astro")).default
	: null;

const gridCols = isSingleColumnLayout
	? "grid-cols-1"
	: "grid-cols-1 md:grid-cols-[minmax(0,1fr)_17rem]";

const mainPanelTop = "5.5rem";
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} whiteBackground={hideSidebar}>


<IconifyLoader />


<slot slot="head" name="head"></slot>
<div id="top-row" data-over-hero={String(isPostPageCheck)} class="z-50 pointer-events-none fixed top-0 left-0 right-0 transition-[opacity,transform] duration-700">
    <div id="navbar-wrapper" class="pointer-events-auto transition-[opacity,transform] duration-700">
        <Navbar></Navbar>
    </div>
</div>


<div class="absolute w-full z-30 pointer-events-none no-banner-layout" style={`top: ${mainPanelTop}`}>
    <div id="post-header-wrapper" class="pointer-events-auto">
        <slot name="post-header" />
    </div>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative w-full max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid" class={`w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!showSidebarOnMobile ? 'mobile-no-sidebar' : ''}`}
        >
            <div id="home-featured-wrapper" class="col-span-full min-w-0 transition-swup-fade transition-main">
                <slot name="featured" />
            </div>

            <div id="left-sidebar-wrapper" class="contents">
                {!isSingleColumnLayout && (
                    <LeftSideBar
                        headings={headings}
                        isPostPage={isPostPageCheck}
                        class="hidden md:flex md:flex-col md:row-start-[var(--content-row)] md:row-span-1 md:col-start-2 md:col-end-3 md:self-stretch transition-main"
                    />
                )}
            </div>

            {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
            <main id="swup-container" class:list={[
                "overflow-hidden w-full min-w-0",
                { "transition-swup-fade transition-main": !isPostPageCheck },
                isSingleColumnLayout
                    ? wideContent
                        ? "max-w-none mx-auto"
                        : "max-w-[calc(var(--page-width)-18rem)] mx-auto"
                    : "md:row-start-[var(--content-row)] md:col-start-1 md:col-end-2",
            ]}>
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} data-white-bg={String(hideSidebar)} class="hidden"></div>
                {/* 备用 h1 标题 - 当主页横幅文本未启用时，提供隐藏的主标题 */}
                {isHomePageCheck && (
                        <h1 class="sr-only">{siteConfig.title}</h1>
                )}
                <div id="content-wrapper" class:list={{ "onload-animation": !isPostPageCheck }}>
                    <slot></slot>
                </div>
            </main>

            {/* 占位容器：保留 swup container 不变 */}
            <div id="right-sidebar-static" class="hidden"></div>
            <div id="right-sidebar-dynamic" class="hidden"></div>

        </div>
    </div>
    <div class="footer pointer-events-auto transition-swup-fade transition-main">
        <Footer />
    </div>
</div>

  <div slot="floating-controls" id="floating-toc-container" class="contents">
    {PostPageTOC && <PostPageTOC headings={headings} />}
  </div>
</Layout>

<style is:global>
  #post-header-wrapper:empty {
    display: none;
  }
  .no-banner-layout:has(.post-hero) {
    grid-template-rows: auto 1fr auto;
  }
  #main-grid {
    --content-row: 1;
  }
  body[data-page-type="home"] #main-grid {
    max-width: 72rem;
  }
  #main-grid:has(.home-featured) {
    --content-row: 2;
  }
  #home-featured-wrapper:not(:has(.home-featured)) {
    display: none;
  }
  .home-featured .home-carousel {
    margin-bottom: 0;
  }

  :root:not(.dark):has(body[data-page-type="post"]) {
    background-color: #f9f9f9 !important;
  }
  :root:not(.dark) body[data-page-type="post"] {
    background-color: #f9f9f9 !important;
  }

  :root:not(.dark):has(body[data-white-bg="true"]) {
    background-color: #f9f9f9 !important;
  }
  body[data-white-bg="true"] {
    background-color: transparent !important;
  }

  /* 右侧栏平滑过渡 */
  body[data-page-type="post"] #swup-container {
    grid-column: 1 / -1;
    max-width: calc(var(--page-width) - 18rem);
    margin-inline: auto;
  }

  #right-sidebar {
    transition: opacity 0.35s ease-in-out, 
                transform 0.35s ease-in-out;
  }

</style>

