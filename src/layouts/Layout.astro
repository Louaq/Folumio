---
import FontSetup from "@components/features/FontSetup.astro";
import ImageLightboxManager from "@components/features/ImageLightboxManager.astro";
import ConfigCarrier from "@components/layout/ConfigCarrier.astro";

import {
	expressiveCodeConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import { PAGE_WIDTH } from "@/constants/constants";
import { isHomePage } from "@/utils/layout-utils";
import { url } from "@/utils/url-utils";

import "@/styles/main.css";
import "@/styles/theme-switch.css";
import "@/styles/navbar-theme.css";
import "@/styles/post-list.css";
import "@/styles/transition.css";
import "@/styles/image-zoom.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	whiteBackground?: boolean;
}

let { title, description, lang, setOGTypeArticle, postSlug, whiteBackground } =
	Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);

const themeColor = siteConfig.themeColor.color;


const pageType = isHomePageCheck ? "home" : postSlug ? "post" : "page";

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.subtitle
		? `${siteConfig.title} - ${siteConfig.subtitle}`
		: siteConfig.title;
}

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");


const collapsibleEnabled =
	expressiveCodeConfig.pluginCollapsible?.enable === true;
const collapsiblePreviewLines =
	expressiveCodeConfig.pluginCollapsible?.previewLines ?? 8;
---

<!doctype html>
<html lang={siteLang} class="bg-(--page-bg) text-[14px] md:text-[16px]" data-language-badge-enabled={String(expressiveCodeConfig.pluginLanguageBadge?.enable !== false)}>
  <head>
    <title>{pageTitle}</title>

    <meta charset="UTF-8" />
    <style is:inline>@layer properties, theme, base, components, utilities;</style>

    <link rel="preconnect" href="https://pic1.imgdb.cn" crossorigin />
    <link rel="dns-prefetch" href="https://pic1.imgdb.cn" />
    <link
      rel="preconnect"
      href="https://yangyang666.oss-cn-chengdu.aliyuncs.com"
      crossorigin
    />
    <link
      rel="dns-prefetch"
      href="https://yangyang666.oss-cn-chengdu.aliyuncs.com"
    />

    <meta
      name="description"
      content={description || siteConfig.description || pageTitle}
    />
    {
      siteConfig.keywords && siteConfig.keywords.length > 0 && (
        <meta name="keywords" content={siteConfig.keywords.join(", ")} />
      )
    }
    <meta name="author" content={profileConfig.name} />

    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description || siteConfig.description || pageTitle}
    />
    {
      setOGTypeArticle ? (
        <meta property="og:type" content="article" />
      ) : (
        <meta property="og:type" content="website" />
      )
    }

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {
      siteConfig.favicon.map((favicon) => (
        <link
          rel="icon"
          href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
          sizes={favicon.sizes}
          media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
        />
      ))
    }

    <!-- Set the theme before the page is rendered to avoid a flash -->
    <script
      is:inline
      define:vars={{
        themeColor,
        defaultMode: siteConfig.themeColor.defaultMode ?? "light",
        darkTheme: expressiveCodeConfig.darkTheme,
        lightTheme: expressiveCodeConfig.lightTheme,
      }}
    >
      const LIGHT_MODE = "light";
      const DARK_MODE = "dark";

      const storedTheme = localStorage.getItem("theme") || defaultMode;
      const theme = storedTheme === DARK_MODE ? DARK_MODE : LIGHT_MODE;
      document.documentElement.setAttribute("data-theme-mode", theme);
      const isDark = theme === DARK_MODE;

      if (isDark) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      document.documentElement.setAttribute(
        "data-theme",
        isDark ? darkTheme : lightTheme
      );

      document.documentElement.dataset.expressiveDarkTheme = darkTheme;
      document.documentElement.dataset.expressiveLightTheme = lightTheme;

      document.documentElement.style.setProperty("--theme-color", themeColor);

    </script>
    <style
      define:vars={{
        "page-width": `${PAGE_WIDTH}rem`,
      }}
    ></style>
    {collapsibleEnabled && (
      <style is:global set:html={`.ec-collapse{--ec-collapse-preview-height:calc(${collapsiblePreviewLines} * 1.5rem + 2rem);}`} />
    )}

    <slot name="head" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={profileConfig.name}
      href={`${Astro.site}rss.xml`}
    />

    <FontSetup />

  </head>
  <body
    class="min-h-screen"
    class:list={[
      {
        "lg:is-home": isHomePageCheck,
        "enable-card-border": siteConfig.card?.border,
      },
    ]}
    data-page-type={pageType}
    data-white-bg={String(!!whiteBackground)}
  >
    <ConfigCarrier />
    <slot />

    <!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
    <div id="page-height-extend" class="hidden h-[300vh]"></div>

    <ImageLightboxManager />

  </body>
</html>


<script>
  import { pathsEqual, url } from "@/utils/url-utils";
  import { expressiveCodeConfig, siteConfig } from "@/config";
  import { initArchivePage } from "@/utils/archive-init";
  import { initPostCardDelegation } from "@/utils/post-card-init";
  import { initCoverImages } from "@/utils/cover-image-init";
  import { initMarkdownImages } from "@/utils/markdown-image-init";
  import { initPostPageTOC } from "@/utils/post-page-toc-init";
  import { initCodeCopyFeedback } from "@/utils/code-copy-feedback-init";
  import { initCodeFullscreen } from "@/utils/code-fullscreen-init";
  import { warmUpDeferredBlocks } from "@/utils/deferred-block-warmup";
  import { initPromoStrip } from "@/utils/promo-init";

  initPostCardDelegation();
  initCoverImages();
  initPostPageTOC();
  initMarkdownImages();
  initCodeCopyFeedback();
  initCodeFullscreen();
  initPromoStrip();
  warmUpDeferredBlocks();

  let copyResetTimer: ReturnType<typeof setTimeout>;

  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("#post-share");
    if (!button) return;

    const label = button.querySelector("[data-share-label]")!;
    try {
      await navigator.clipboard.writeText(button.dataset.url!);
      label.textContent = button.dataset.copied!;
      button.title = button.dataset.copied!;
      clearTimeout(copyResetTimer);
      copyResetTimer = setTimeout(() => {
        label.textContent = button.dataset.label!;
        button.title = button.getAttribute("aria-label")!;
      }, 3000);
    } catch {
      label.textContent = button.dataset.failed!;
      button.title = button.dataset.failed!;
    }
  });

  function setClickOutsideToClose(panel: string, ignores: string[]) {
      document.addEventListener("click", (event) => {
          let panelDom = document.getElementById(panel);
          if (!panelDom) return;
          let tDom = event.target;
          if (!(tDom instanceof Node)) return; // Ensure the event target is an HTML Node
          for (let ig of ignores) {
              let ie = document.getElementById(ig);
              if (ie == tDom || ie?.contains(tDom)) {
                  return;
              }
          }
          panelDom.classList.add("float-panel-closed");
      });
  }
  setClickOutsideToClose("nav-menu-panel", [
    "nav-menu-panel",
    "nav-menu-switch",
  ]);
  setClickOutsideToClose("search-panel", [
    "search-panel",
    "search-bar",
    "search-switch",
  ]);
  setClickOutsideToClose("theme-mode-panel", [
    "theme-mode-panel",
    "scheme-switch",
  ]);

  function initCustomScrollbar() {
    const katexElements = document.querySelectorAll(
      ".katex-display:not([data-scrollbar-initialized])"
    ) as NodeListOf<HTMLElement>;
    katexElements.forEach((element) => {
      if (!element.parentNode) return;

      const container = document.createElement("div");
      container.className = "katex-display-container";
      element.parentNode.insertBefore(container, element);
      container.appendChild(element);

      container.style.cssText = `
			overflow-x: auto;
		`;

      element.setAttribute("data-scrollbar-initialized", "true");
    });
  }


  function scrollWindowTopInstant() {
    const root = document.documentElement;
    const prev = root.style.scrollBehavior;
    root.style.scrollBehavior = "auto";
    window.scrollTo(0, 0);
    root.scrollTop = 0;
    document.body.scrollTop = 0;
    requestAnimationFrame(() => {
      root.style.scrollBehavior = prev;
    });
  }

  const setup = () => {
    const MAX_SWUP_CACHE_PAGES = 6;
    const moduleKey = (s: HTMLScriptElement) => s.src || s.textContent;
    const executedModules = new Set(
      Array.from(document.querySelectorAll<HTMLScriptElement>('script[type="module"]'), moduleKey),
    );
    window.swup.hooks.on("content:replace", () => {
      for (const old of document.querySelectorAll<HTMLScriptElement>("script")) {
        if (old.type === "module") {
          const key = moduleKey(old);
          if (executedModules.has(key)) continue;
          executedModules.add(key);
        } else if (old.type || old.src) {
          continue;
        }
        const script = document.createElement("script");
        for (const { name, value } of Array.from(old.attributes)) {
          script.setAttribute(name, value);
        }
        script.textContent = old.textContent;
        old.replaceWith(script);
      }
    });
    window.swup.hooks.on("cache:set", () => {
      const cachedUrls = Array.from(window.swup.cache.all.keys()) as string[];
      while (cachedUrls.length > MAX_SWUP_CACHE_PAGES) {
        const oldest = cachedUrls.shift();
        if (oldest) window.swup.cache.delete(oldest);
      }
    });
    window.swup.hooks.on("link:click", (_visit: any, { el }: { el: HTMLAnchorElement }) => {
      document.documentElement.style.setProperty("--content-delay", "0ms");

      const targetHref = el?.getAttribute("href") || "";
      const targetPathname = (() => {
        try {
          return new URL(targetHref, window.location.origin).pathname;
        } catch {
          return targetHref;
        }
      })();
      const isSamePage = pathsEqual(targetPathname, window.location.pathname);
      if (!isSamePage) {
        document.documentElement.classList.add("is-page-transitioning");
      }

     
    });
    window.swup.hooks.on("content:replace", () => {
      (window as any).__swupScrollLockY = null;

      initArchivePage();
      initCoverImages();
      initPostPageTOC();
      initMarkdownImages();
      warmUpDeferredBlocks();

      const gridClassCarrier = document.getElementById("grid-class-carrier");
      if (gridClassCarrier) {
        const gridClass = gridClassCarrier.getAttribute("data-grid-class");
        const mainGrid = document.getElementById("main-grid");
        if (mainGrid && gridClass) {

          const currentClasses = mainGrid.className.split(" ");
          const newClasses = currentClasses.filter(c => !c.startsWith("lg:grid-cols-") && !c.startsWith("md:grid-cols-") && !c.startsWith("grid-cols-"));

          const gridClasses = gridClass.split(" ");
          mainGrid.className = [...newClasses, ...gridClasses].join(" ");
        }

        document.body.dataset.whiteBg = gridClassCarrier.dataset.whiteBg;
      }


      initCustomScrollbar();
      
      import("@/utils/icon-loader").then(({ initIconLoader }) => {
        initIconLoader();
      });



    });
    window.swup.hooks.on("visit:start", (visit: {
      from?: { url: string; hash?: string };
      to: { url: string };
      history?: { popstate?: boolean; direction?: string };
      scroll?: { reset?: boolean };
    }) => {
      const fromPath = visit.from?.url ?? (window.location.pathname + window.location.search);
      const fromHash = visit.from?.hash ?? window.location.hash;
      const currentKey = "swup-scroll:" + fromPath + (fromHash || "");
      try {
        sessionStorage.setItem(currentKey, String(window.scrollY || document.documentElement.scrollTop));
      } catch (_e) { /* ignore */ }

      if (visit.history?.popstate) {
        if (visit.scroll) visit.scroll.reset = false;
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        if (scrollY > 0) {
          (window as any).__swupScrollLockY = scrollY;
          const tick = () => {
            if ((window as any).__swupScrollLockY == null) return;
            const current = window.scrollY || document.documentElement.scrollTop;
            if (current !== (window as any).__swupScrollLockY) {
              window.scrollTo(0, (window as any).__swupScrollLockY);
            }
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }

      const bodyElement = document.querySelector("body");
      const isHomePage = pathsEqual(visit.to.url, url("/"));
      const toPathname = new URL(visit.to.url, window.location.href).pathname;
      const isPostPage = /\/posts\/.+/.test(toPathname);
      const nextPageType = isHomePage ? "home" : isPostPage ? "post" : "page";
      if (bodyElement) {
        bodyElement.dataset.pageType = nextPageType;
      }

      if (isHomePage) {
        bodyElement!.classList.add("lg:is-home");
      } else {
        bodyElement!.classList.remove("lg:is-home");
      }


      document
        .getElementById("navbar")
        ?.setAttribute("data-is-home", isHomePage.toString());

      const isMobile = window.innerWidth < 1024;
      if (isMobile) {
        const postListContainer = document.getElementById("post-list-container");
        if (postListContainer) {
          postListContainer.style.transition = "none";
        }
      }

      // increase the page height during page transition to prevent the scrolling animation from jumping
      const heightExtend = document.getElementById("page-height-extend");
      if (heightExtend) {
        heightExtend.classList.remove("hidden");
      }

    });
    window.swup.hooks.on("page:view", (visit?: {
      history?: { popstate?: boolean };
    }) => {
      const heightExtend = document.getElementById("page-height-extend");
      if (heightExtend) {
        heightExtend.classList.remove("hidden");
      }
      const isHistoryNav = visit?.history?.popstate === true;
      const restoreKey = "swup-scroll:" + (window.location.pathname + window.location.search + window.location.hash);

      if (isHistoryNav) {
        let savedY: number | null = null;
        try {
          const stored = sessionStorage.getItem(restoreKey);
          if (stored != null) {
            savedY = parseInt(stored, 10);
            sessionStorage.removeItem(restoreKey);
          }
        } catch (_e) { /* ignore */ }

        if (savedY != null && !isNaN(savedY) && savedY > 0) {
          const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
          requestAnimationFrame(() => {
            window.scrollTo(0, Math.min(savedY!, maxY));
          });
        }
      } else {
        scrollWindowTopInstant();
      }

      const isMobile = window.innerWidth < 1024;
      if (isMobile) {
        setTimeout(() => {
          const postListContainer = document.getElementById("post-list-container");
          if (postListContainer) {
            postListContainer.style.transition = "";
          }
        }, 600);
      }


      const storedTheme = localStorage.getItem("theme") || siteConfig.themeColor.defaultMode || "light";
      const isDark = storedTheme === "dark";
      const expectedTheme = isDark
        ? expressiveCodeConfig.darkTheme
        : expressiveCodeConfig.lightTheme;
      const currentTheme = document.documentElement.getAttribute("data-theme");

      if (currentTheme !== expectedTheme) {
        document.documentElement.setAttribute("data-theme", expectedTheme);
      }
    });
    window.swup.hooks.on("visit:end", (_visit: { to: { url: string } }) => {
      (window as any).__swupScrollLockY = null;

      setTimeout(() => {
        const heightExtend = document.getElementById("page-height-extend");
        if (heightExtend) {
          heightExtend.classList.add("hidden");
        }


        document.documentElement.classList.remove("is-page-transitioning");
      }, 200);
    });


  };
  if (window?.swup?.hooks) {
    setup();
  } else {
    document.addEventListener("swup:enable", setup);
  }



  initCustomScrollbar();

  import { initIconLoader } from "@/utils/icon-loader";
  const initOptionalRuntime = () => {
    initIconLoader();
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initOptionalRuntime, { once: true });
  } else {
    initOptionalRuntime();
  }
</script>
