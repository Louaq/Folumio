---
import FontSetup from "@components/features/FontSetup.astro";
import ImageLightboxManager from "@components/features/ImageLightboxManager.astro";
import ConfigCarrier from "@components/layout/ConfigCarrier.astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";

import {
	expressiveCodeConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import { PAGE_WIDTH } from "@/constants/constants";
import { isHomePage, url } from "@/utils/navigation";

import "@/styles/main.css";
import "@/styles/theme-switch.css";
import "@/styles/navbar.css";
import "@/styles/post-list.css";
import "@/styles/transition.css";
import "@/styles/image-zoom.css";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "@/styles/fancybox-custom.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	whiteBackground?: boolean;
}

let { title, description, lang, setOGTypeArticle, postSlug, whiteBackground } =
	Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);

const themeColor = siteConfig.themeColor.color;


const pageType = isHomePageCheck ? "home" : postSlug ? "post" : "page";

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.subtitle
		? `${siteConfig.title} - ${siteConfig.subtitle}`
		: siteConfig.title;
}

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");


const collapsibleEnabled =
	expressiveCodeConfig.pluginCollapsible?.enable === true;
const collapsiblePreviewLines =
	expressiveCodeConfig.pluginCollapsible?.previewLines ?? 8;
---

<!doctype html>
<html
  lang={siteLang}
  class="has-page-scrollbar bg-(--page-bg) text-[14px] md:text-[16px]"
>
  <head>
    <title>{pageTitle}</title>

    <meta charset="UTF-8" />
    <script is:inline>
      // Restore reloads before the first paint; Swup owns client navigation.
      if (!window.swup) {
        const scrollKey = "folumio:reload-scroll";
        window.addEventListener("pagehide", () => {
          sessionStorage.setItem(scrollKey, JSON.stringify({ url: location.href, top: scrollY }));
        });
        history.scrollRestoration = "auto";
        if (performance.getEntriesByType("navigation")[0].type === "reload") {
          document.documentElement.classList.add("is-reload");
          const saved = JSON.parse(sessionStorage.getItem(scrollKey) || "null");
          if (saved?.url === location.href) {
            history.scrollRestoration = "manual";
            document.documentElement.dataset.reloadScroll = String(saved.top);
            document.documentElement.classList.add("is-restoring-scroll");
          }
        }
      }
    </script>
    <style is:inline>
      html.is-restoring-scroll { visibility: hidden; }
      /* Keep measured block sizes stable throughout a reloaded page. */
      html.is-reload .custom-md :is(.expressive-code, .katex-display-container) {
        content-visibility: visible;
      }
    </style>
    <style is:inline>@layer properties, theme, base, components, utilities;</style>

    <meta
      name="description"
      content={description || siteConfig.description || pageTitle}
    />
    {
      siteConfig.keywords && siteConfig.keywords.length > 0 && (
        <meta name="keywords" content={siteConfig.keywords.join(", ")} />
      )
    }
    <meta name="author" content={profileConfig.name} />

    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description || siteConfig.description || pageTitle}
    />
    {
      setOGTypeArticle ? (
        <meta property="og:type" content="article" />
      ) : (
        <meta property="og:type" content="website" />
      )
    }

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {
      siteConfig.favicon.map((favicon) => (
        <link
          rel="icon"
          href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
          sizes={favicon.sizes}
          media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
        />
      ))
    }

    <!-- Set the theme before the page is rendered to avoid a flash -->
    <script
      is:inline
      define:vars={{
        themeColor,
        defaultMode: siteConfig.themeColor.defaultMode ?? "light",
        darkTheme: expressiveCodeConfig.darkTheme,
        lightTheme: expressiveCodeConfig.lightTheme,
      }}
    >
      const DARK_MODE = "dark";

      const storedTheme = localStorage.getItem("theme") || defaultMode;
      const theme = storedTheme;
      document.documentElement.setAttribute("data-theme-mode", theme);
      const isDark = theme === DARK_MODE || (theme === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);

      if (isDark) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      document.documentElement.setAttribute(
        "data-theme",
        isDark ? darkTheme : lightTheme
      );

      document.documentElement.dataset.expressiveDarkTheme = darkTheme;
      document.documentElement.dataset.expressiveLightTheme = lightTheme;

      document.documentElement.style.setProperty("--theme-color", themeColor);

    </script>
    <style
      define:vars={{
        "page-width": `${PAGE_WIDTH}rem`,
      }}
    ></style>
    {collapsibleEnabled && (
      <style is:global set:html={`.ec-collapse{--ec-collapse-preview-height:calc(${collapsiblePreviewLines} * 1.5rem + 2rem);}`} />
    )}

    <slot name="head" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={profileConfig.name}
      href={`${Astro.site}rss.xml`}
    />

    <FontSetup />

  </head>
  <body
    class="min-h-screen enable-card-border"
    class:list={[
      {
        "lg:is-home": isHomePageCheck,
      },
    ]}
    data-page-type={pageType}
    data-white-bg={String(!!whiteBackground)}
  >
    <ConfigCarrier />
    <slot />

    <!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
    <div id="page-height-extend" class="hidden h-[300vh]"></div>

    <ImageLightboxManager />
    <FloatingControls><slot name="floating-controls" /></FloatingControls>

    <script is:inline>
      {
        // Scroll-driven app bar state adapted from LyraVoid/Shirone Layout.astro (MIT).
        function updateNavbarHeroOverlap() {
          const scrollTop = Math.max(document.body.scrollTop, document.documentElement.scrollTop);
          const navbar = document.getElementById("navbar");
          if (!navbar) return; // The 404 layout has no app bar or banner.
          const banner = document.querySelector(".banner-stage");
          const bannerHeight = banner.getBoundingClientRect().height;
          const overBanner = scrollTop < Math.max(0, bannerHeight - 64);
          document.body.dataset.bannerScrolled = String(!overBanner);
          navbar.classList.toggle("top-app-bar--transparent", overBanner);
          navbar.classList.toggle("top-app-bar--scrolled", scrollTop > 16);
        }

        const root = document.documentElement;
        function revealPage() {
          // Match the restored viewport before revealing it.
          updateNavbarHeroOverlap();
          const navbar = document.getElementById("navbar");
          if (navbar) {
            // Commit the initial background before enabling scroll transitions.
            getComputedStyle(navbar.firstElementChild).backgroundColor;
            navbar.dataset.ready = "";
          }
          root.classList.remove("is-restoring-scroll");
        }
        if (root.dataset.reloadScroll !== undefined) {
          // Formula wrappers must be initialized before measuring the restored page.
          document.addEventListener("folumio:page-features-ready", () => {
            root.getBoundingClientRect();
            document.fonts.ready.then(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  window.scrollTo({ top: Number(root.dataset.reloadScroll), behavior: "instant" });
                  delete root.dataset.reloadScroll;
                  revealPage();
                });
              });
            });
          }, { once: true });
        } else {
          revealPage();
        }
      }
    </script>
  </body>
</html>


<script>
  import "@/utils/layout-init";
</script>
